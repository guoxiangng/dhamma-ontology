@prefix dho:  <https://guoxiangng.github.io/dhamma-ontology/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# SN 46.57-76: twenty practices, each "very fruitful and beneficial" when developed (D14, D15).
# SN 46.57 and 46.76 are given in full; SN 46.58-75 are abbreviated in the Pali (D14).
# Generated once from a table (scratch script); edit by hand from now on.

# ---------------------------------------------------------------- outcome targets

dho:GreatFruit a dho:Concept ; skos:prefLabel "great fruit and benefit"@en , "mahapphala mahānisaṁsa"@pi .
dho:Enlightenment a dho:Concept ; skos:prefLabel "enlightenment in this very life"@en , "aññā"@pi .
dho:NonReturn a dho:Concept ; skos:prefLabel "non-return"@en , "anāgāmitā"@pi .
dho:GreatBenefit a dho:Concept ; skos:prefLabel "great benefit"@en , "attha"@pi .
dho:SanctuaryFromYoke a dho:Concept ; skos:prefLabel "great sanctuary from the yoke"@en , "yogakkhema"@pi .
dho:Inspiration a dho:Concept ; skos:prefLabel "great inspiration"@en , "saṁvega"@pi .
# phāsuvihāra. The preferred label was "great ease", but "great" is SN 46.57's mahato, not part of the
# word; changed after the batch 6 audit (2026-11-15). The outcomes keep their verbatim wording.
dho:GreatEase a dho:Concept ; skos:prefLabel "living at ease"@en , "phāsuvihāra"@pi ; skos:altLabel "ease"@en .

# ---------------------------------------------------------------- the practices

dho:SkeletonPerception a dho:Practice ; skos:prefLabel "the perception of a skeleton"@en , "aṭṭhikasaññā"@pi .
dho:WormInfestedPerception a dho:Practice ; skos:prefLabel "the perception of a worm-infested corpse"@en , "puḷavakasaññā"@pi .
dho:LividPerception a dho:Practice ; skos:prefLabel "the perception of a livid corpse"@en , "vinīlakasaññā"@pi .
dho:SplitOpenPerception a dho:Practice ; skos:prefLabel "the perception of a split open corpse"@en , "vicchiddakasaññā"@pi .
dho:BloatedPerception a dho:Practice ; skos:prefLabel "the perception of a bloated corpse"@en , "uddhumātakasaññā"@pi .
dho:Love a dho:Practice ; skos:prefLabel "love"@en , "mettā"@pi ;
    dho:editorialRelated dho:o-metta .
dho:Compassion a dho:Practice ; skos:prefLabel "compassion"@en , "karuṇā"@pi .
dho:Rejoicing a dho:Practice ; skos:prefLabel "rejoicing"@en , "muditā"@pi .
dho:EquanimityImmeasurable a dho:Practice ; skos:prefLabel "equanimity"@en , "upekkhā"@pi ;
    dho:editorialRelated dho:Equanimity .
dho:MindfulnessOfBreathing a dho:Practice ; skos:prefLabel "mindfulness of breathing"@en , "ānāpānassati"@pi .
dho:UglinessPerception a dho:Practice ; skos:prefLabel "the perception of ugliness"@en , "asubhasaññā"@pi ;
    dho:editorialRelated dho:o-ugliness .
dho:DeathPerception a dho:Practice ; skos:prefLabel "the perception of death"@en , "maraṇasaññā"@pi .
dho:FoodRepulsivenessPerception a dho:Practice ; skos:prefLabel "the perception of repulsiveness of food"@en , "āhāre paṭikūlasaññā"@pi .
dho:WorldDissatisfactionPerception a dho:Practice ; skos:prefLabel "the perception of dissatisfaction with the whole world"@en , "sabbaloke anabhiratisaññā"@pi .
dho:ImpermanencePerception a dho:Practice ; skos:prefLabel "the perception of impermanence"@en , "aniccasaññā"@pi .
dho:SufferingInImpermanencePerception a dho:Practice ; skos:prefLabel "the perception of suffering in impermanence"@en , "anicce dukkhasaññā"@pi .
dho:NotSelfInSufferingPerception a dho:Practice ; skos:prefLabel "the perception of not-self in suffering"@en , "dukkhe anattasaññā"@pi .
dho:GivingUpPerception a dho:Practice ; skos:prefLabel "the perception of giving up"@en , "pahānasaññā"@pi .
dho:DispassionPerception a dho:Practice ; skos:prefLabel "the perception of dispassion"@en , "virāgasaññā"@pi .
dho:CessationPerception a dho:Practice ; skos:prefLabel "the perception of cessation"@en , "nirodhasaññā"@pi .

