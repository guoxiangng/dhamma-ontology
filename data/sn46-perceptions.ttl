# ---------------------------------------------------------------- SN 46.57 and 46.76 in full

dho:o-p57-a a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:CanExpect ; dho:to dho:Enlightenment ;
    dho:wording "enlightenment in this very life" ; skos:note "One of two results: enlightenment in this very life or, if there is residue left behind, non-return."@en ; dho:citedBy dho:p-sn46.57-2.1 .
dho:o-p57-b a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:CanExpect ; dho:to dho:NonReturn ;
    dho:wording "non-return" ; skos:note "One of two results: enlightenment in this very life or, if there is residue left behind, non-return."@en ; dho:citedBy dho:p-sn46.57-2.1 .
dho:o-p57-c a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:LeadsTo ; dho:to dho:GreatBenefit ;
    dho:wording "great benefit" ; dho:citedBy dho:p-sn46.57-3.1 .
dho:o-p57-d a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:LeadsTo ; dho:to dho:SanctuaryFromYoke ;
    dho:wording "great sanctuary from the yoke" ; dho:citedBy dho:p-sn46.57-4.1 .
dho:o-p57-e a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:LeadsTo ; dho:to dho:Inspiration ;
    dho:wording "great inspiration" ; dho:citedBy dho:p-sn46.57-5.1 .
dho:o-p57-f a dho:Outcome ; dho:of dho:SkeletonPerception ; dho:effect dho:LeadsTo ; dho:to dho:GreatEase ;
    dho:wording "great ease" ; dho:citedBy dho:p-sn46.57-6.1 .
# Corrected 2026-11-15 (D19): the Pali develops the awakening factor accompanied by the perception
# (aṭṭhikasaññāsahagataṁ satisambojjhaṅgaṁ bhāveti); this had followed the English and was reversed.
dho:c-p57 a dho:Condition ; dho:condition dho:SkeletonPerception ; dho:relation dho:Accompanies ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "aṭṭhikasaññāsahagataṁ" ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of a skeleton. Sujato's English: 'develops the perception of a skeleton together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.57-1.4 , dho:p-sn46.57-1.5 .

dho:o-p76-a a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:CanExpect ; dho:to dho:Enlightenment ;
    dho:wording "enlightenment in this very life" ; skos:note "One of two results: enlightenment in this very life or, if there is residue left behind, non-return."@en ; dho:citedBy dho:p-sn46.76-2.1 , dho:p-sn46.76-2.2 , dho:p-sn46.76-2.7 , dho:p-sn46.76-2.8 .
dho:o-p76-b a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:CanExpect ; dho:to dho:NonReturn ;
    dho:wording "non-return" ; skos:note "One of two results: enlightenment in this very life or, if there is residue left behind, non-return."@en ; dho:citedBy dho:p-sn46.76-2.1 , dho:p-sn46.76-2.2 , dho:p-sn46.76-2.7 , dho:p-sn46.76-2.8 .
dho:o-p76-c a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:LeadsTo ; dho:to dho:GreatBenefit ;
    dho:wording "great benefit" ; dho:citedBy dho:p-sn46.76-3.1 , dho:p-sn46.76-3.5 .
dho:o-p76-d a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:LeadsTo ; dho:to dho:SanctuaryFromYoke ;
    dho:wording "great sanctuary from the yoke" ; dho:citedBy dho:p-sn46.76-3.1 , dho:p-sn46.76-3.5 .
dho:o-p76-e a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:LeadsTo ; dho:to dho:Inspiration ;
    dho:wording "great inspiration" ; dho:citedBy dho:p-sn46.76-3.1 , dho:p-sn46.76-3.5 .
dho:o-p76-f a dho:Outcome ; dho:of dho:CessationPerception ; dho:effect dho:LeadsTo ; dho:to dho:GreatEase ;
    dho:wording "great ease" ; dho:citedBy dho:p-sn46.76-3.1 , dho:p-sn46.76-3.5 .
# Corrected 2026-11-15 (D19), as c-p57.
dho:c-p76 a dho:Condition ; dho:condition dho:CessationPerception ; dho:relation dho:Accompanies ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "nirodhasaññāsahagataṁ" ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of cessation. Sujato's English: 'develops the perception of cessation together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.76-1.3 , dho:p-sn46.76-1.4 , dho:p-sn46.76-2.5 , dho:p-sn46.76-2.6 , dho:p-sn46.76-3.3 , dho:p-sn46.76-3.4 .

