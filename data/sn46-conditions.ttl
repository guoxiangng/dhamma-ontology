@prefix dho:  <https://guoxiangng.github.io/dhamma-ontology/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Pattern B, conditions (D13). The relation is a small controlled set; the wording keeps the
# sutta's own words (S14 checks it is in a cited passage).

dho:c-01 a dho:Condition ; dho:condition dho:Ethics ; dho:relation dho:BasisOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "depending on and grounded on ethics" ;
    dho:citedBy dho:p-sn46.1-1.4 , dho:p-sn46.11-1.3 .

dho:c-02 a dho:Condition ; dho:condition dho:GoodFriendship ; dho:relation dho:ForerunnerOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "good friendship is the forerunner and harbinger of the arising of the seven awakening factors" ;
    dho:citedBy dho:p-sn46.12-1.2 , dho:p-sn46.48-1.2 .
dho:c-03 a dho:Condition ; dho:condition dho:GoodFriendship ; dho:relation dho:Supports ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" ;
    dho:citedBy dho:p-sn46.12-1.3 , dho:p-sn46.48-1.3 .
dho:c-04 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:ForerunnerOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "rational application of mind is the forerunner and harbinger of the arising of the seven awakening factors" ;
    dho:citedBy dho:p-sn46.13-1.2 .
dho:c-05 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:Supports ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" ;
    dho:citedBy dho:p-sn46.13-1.3 , dho:p-sn46.32-1.2 .

dho:c-06 a dho:Condition ; dho:condition dho:Diligence ; dho:relation dho:RootOf ; dho:conditioned dho:SkillfulQualities ;
    dho:wording "rooted in diligence and meet at diligence" ;
    dho:citedBy dho:p-sn46.31-1.1 .
dho:c-07 a dho:Condition ; dho:condition dho:Diligence ; dho:relation dho:Supports ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" ;
    dho:citedBy dho:p-sn46.31-1.2 .
dho:c-08 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:RootOf ; dho:conditioned dho:SkillfulQualities ;
    dho:wording "rooted in rational application of mind and meet at rational application of mind" ;
    dho:citedBy dho:p-sn46.32-1.1 .

dho:c-09 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:GivesRiseTo ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "gives rise to the seven awakening factors like rational application of mind" ;
    skos:note "Said of interior factors: nothing interior gives rise to them like rational application of mind."@en ;
    dho:citedBy dho:p-sn46.49-1.1 .
dho:c-10 a dho:Condition ; dho:condition dho:GoodFriendship ; dho:relation dho:GivesRiseTo ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "gives rise to the seven awakening factors like good friendship" ;
    skos:note "Said of exterior factors: nothing exterior gives rise to them like good friendship."@en ;
    dho:citedBy dho:p-sn46.50-1.1 .

dho:c-11 a dho:Condition ; dho:condition dho:IrrationalAttention ; dho:relation dho:WhenThen ; dho:conditioned dho:FiveHindrances ; dho:result dho:Arises ;
    dho:wording "when you apply the mind irrationally" ;
    dho:citedBy dho:p-sn46.24-1.1 , dho:p-sn46.24-1.5 , dho:p-sn46.35-1.1 .
dho:c-12 a dho:Condition ; dho:condition dho:IrrationalAttention ; dho:relation dho:WhenThen ; dho:conditioned dho:SevenAwakeningFactors ; dho:result dho:DoesNotArise ;
    dho:wording "when you apply the mind irrationally" ;
    dho:citedBy dho:p-sn46.24-1.1 , dho:p-sn46.24-1.6 .
dho:c-13 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:WhenThen ; dho:conditioned dho:FiveHindrances ; dho:result dho:DoesNotArise ;
    dho:wording "when you apply the mind rationally" ;
    dho:citedBy dho:p-sn46.24-2.1 , dho:p-sn46.24-2.5 .
dho:c-14 a dho:Condition ; dho:condition dho:RationalAttention ; dho:relation dho:WhenThen ; dho:conditioned dho:SevenAwakeningFactors ; dho:result dho:Arises ;
    dho:wording "when you apply the mind rationally" ;
    dho:citedBy dho:p-sn46.24-2.1 , dho:p-sn46.24-3.1 , dho:p-sn46.35-2.1 .

dho:c-15 a dho:Condition ; dho:condition dho:ListeningToTeaching ; dho:relation dho:WhenThen ; dho:conditioned dho:FiveHindrances ; dho:result dho:IsAbsent ;
    dho:wording "actively listens to the teaching" ;
    dho:citedBy dho:p-sn46.38-1.1 , dho:p-sn46.38-3.4 .
dho:c-16 a dho:Condition ; dho:condition dho:ListeningToTeaching ; dho:relation dho:WhenThen ; dho:conditioned dho:SevenAwakeningFactors ; dho:result dho:IsFullyDeveloped ;
    dho:wording "actively listens to the teaching" ;
    dho:citedBy dho:p-sn46.38-1.1 , dho:p-sn46.38-3.4 .

# The stock formula's "relies on seclusion, fading away, and cessation" (nissita), one node per basis.
dho:c-17 a dho:Condition ; dho:condition dho:Seclusion ; dho:relation dho:BasisOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "on seclusion, fading away, and cessation" ;
    dho:citedBy dho:p-sn46.1-1.6 , dho:p-sn46.1-1.12 , dho:p-sn46.5-1.7 , dho:p-sn46.7-2.3 , dho:p-sn46.11-2.3 ,
                dho:p-sn46.12-2.3 , dho:p-sn46.13-2.3 , dho:p-sn46.21-2.5 , dho:p-sn46.31-2.3 , dho:p-sn46.32-2.3 , dho:p-sn46.48-1.6 .
dho:c-18 a dho:Condition ; dho:condition dho:Virāga ; dho:relation dho:BasisOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "on seclusion, fading away, and cessation" ;
    dho:citedBy dho:p-sn46.1-1.6 , dho:p-sn46.1-1.12 , dho:p-sn46.5-1.7 , dho:p-sn46.7-2.3 , dho:p-sn46.11-2.3 ,
                dho:p-sn46.12-2.3 , dho:p-sn46.13-2.3 , dho:p-sn46.21-2.5 , dho:p-sn46.31-2.3 , dho:p-sn46.32-2.3 , dho:p-sn46.48-1.6 .
dho:c-19 a dho:Condition ; dho:condition dho:Cessation ; dho:relation dho:BasisOf ; dho:conditioned dho:SevenAwakeningFactors ;
    dho:wording "on seclusion, fading away, and cessation" ;
    dho:citedBy dho:p-sn46.1-1.6 , dho:p-sn46.1-1.12 , dho:p-sn46.5-1.7 , dho:p-sn46.7-2.3 , dho:p-sn46.11-2.3 ,
                dho:p-sn46.12-2.3 , dho:p-sn46.13-2.3 , dho:p-sn46.21-2.5 , dho:p-sn46.31-2.3 , dho:p-sn46.32-2.3 , dho:p-sn46.48-1.6 .
