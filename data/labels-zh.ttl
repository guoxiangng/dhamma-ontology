# Added 2026-11-17 (D24): the four practices of SN 46.54 and their heart's releases, so that everyday Chinese
# words find them. 喜 and 捨 alone are already rapture's and equanimity's (the awakening factors), so here they
# are search words: a search for 喜 shows both meanings. 慈悲, 四無量心 and 四梵住 are not words of SN 46;
# they are search words only.
dho:Love skos:prefLabel "慈無量"@zh ;
    skos:hiddenLabel "慈"@zh , "慈心"@zh , "慈悲"@zh , "四無量心"@zh , "四梵住"@zh .
dho:Compassion skos:prefLabel "悲無量"@zh ;
    skos:hiddenLabel "悲"@zh , "悲心"@zh , "慈悲"@zh , "四無量心"@zh , "四梵住"@zh .
dho:Rejoicing skos:prefLabel "喜無量"@zh ;
    skos:hiddenLabel "喜"@zh , "喜心"@zh , "隨喜"@zh , "四無量心"@zh , "四梵住"@zh .
dho:EquanimityImmeasurable skos:prefLabel "捨無量"@zh ;
    skos:hiddenLabel "捨"@zh , "捨心"@zh , "四無量心"@zh , "四梵住"@zh .
dho:o-metta skos:prefLabel "慈心解脫"@zh .
dho:HeartsReleaseByCompassion skos:prefLabel "悲心解脫"@zh .
dho:HeartsReleaseByRejoicing skos:prefLabel "喜心解脫"@zh .
dho:HeartsReleaseByEquanimity skos:prefLabel "捨心解脫"@zh .
