@prefix dho:  <https://guoxiangng.github.io/dhamma-ontology/ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Similes in SN 46 (D22). Generated by a script from the source files: dho:image and dho:wording
# are copied verbatim from Sujato's English, never typed. Each simile illustrates claims, a list or
# advice the ontology already has.

dho:sim-dragons a dho:Simile ;
    skos:prefLabel "dragons growing strong on the Himalayas"@en ;
    dho:image "Mendicants, dragons grow and wax strong supported by the Himalayas, the king of mountains." ;
    dho:wording "In the same way, a mendicant develops and cultivates the seven awakening factors depending on and grounded on ethics, acquiring great and abundant good qualities." ;
    dho:illustrates dho:c-01 ;
    skos:note "The dragons grow strong on the mountain, then go down to pools, lakes, streams, rivers and the ocean, acquiring a great and abundant body (1.3); so the mendicant, grounded on ethics, acquires great and abundant good qualities."@en ;
    dho:citedBy dho:p-sn46.1-1.2 , dho:p-sn46.1-1.3 , dho:p-sn46.1-1.4 .

dho:sim-body-food-hindrances a dho:Simile ;
    skos:prefLabel "the body sustained by food (the hindrances)"@en ;
    dho:image "Mendicants, this body is sustained by food. It depends on food to continue, and without food it doesn’t continue." ;
    dho:wording "In the same way, the five hindrances are sustained by fuel. They depend on fuel to continue, and without fuel they don’t continue." ;
    dho:illustrates dho:n-01 , dho:n-02 , dho:n-03 , dho:n-04 , dho:n-05 ;
    dho:citedBy dho:p-sn46.2-1.2 , dho:p-sn46.2-1.3 , dho:p-sn46.2-7.1 , dho:p-sn46.2-7.2 .

dho:sim-body-food-factors a dho:Simile ;
    skos:prefLabel "the body sustained by food (the awakening factors)"@en ;
    dho:image "This body is sustained by food. It depends on food to continue, and without food it doesn’t continue." ;
    dho:wording "In the same way, the seven awakening factors are sustained by fuel. They depend on fuel to continue, and without fuel they don’t continue." ;
    dho:illustrates dho:n-06 , dho:n-07 , dho:n-08 , dho:n-09 , dho:n-10 , dho:n-11 , dho:n-12 ;
    dho:citedBy dho:p-sn46.2-8.1 , dho:p-sn46.2-8.2 , dho:p-sn46.2-16.1 , dho:p-sn46.2-16.2 .

dho:sim-rafters a dho:Simile ;
    skos:prefLabel "the rafters of a bungalow"@en ;
    dho:image "Mendicants, the rafters of a bungalow all slant, slope, and incline to the peak." ;
    dho:wording "In the same way, a mendicant who develops and cultivates the seven awakening factors slants, slopes, and inclines to extinguishment." ;
    dho:illustrates dho:o-02 ;
    dho:citedBy dho:p-sn46.7-1.1 , dho:p-sn46.7-1.2 .

dho:sim-earth a dho:Simile ;
    skos:prefLabel "living creatures depending on the earth"@en ;
    dho:image "sometimes walking, sometimes standing, sometimes sitting, sometimes lying down—all do so depending on the earth and grounded on the earth." ;
    dho:wording "In the same way, a mendicant develops and cultivates the seven awakening factors depending on and grounded on ethics." ;
    dho:illustrates dho:c-01 ;
    dho:citedBy dho:p-sn46.11-1.1 , dho:p-sn46.11-1.2 , dho:p-sn46.11-1.3 .

dho:sim-dawn-friendship a dho:Simile ;
    skos:prefLabel "the dawn before the sunrise (good friendship)"@en ;
    dho:image "Mendicants, the dawn is the forerunner and harbinger of the sunrise." ;
    dho:wording "In the same way, for a mendicant good friendship is the forerunner and harbinger of the arising of the seven awakening factors." ;
    dho:illustrates dho:c-02 ;
    skos:note "The same simile, with the same point, in SN 46.12 and 46.48 (D12)."@en ;
    dho:citedBy dho:p-sn46.12-1.1 , dho:p-sn46.12-1.2 , dho:p-sn46.48-1.1 , dho:p-sn46.48-1.2 .

dho:sim-dawn-attention a dho:Simile ;
    skos:prefLabel "the dawn before the sunrise (rational application of mind)"@en ;
    dho:image "Mendicants, the dawn is the forerunner and harbinger of the sunrise." ;
    dho:wording "In the same way, for a mendicant rational application of mind is the forerunner and harbinger of the arising of the seven awakening factors." ;
    dho:illustrates dho:c-04 ;
    skos:note "The same image as for good friendship (SN 46.12), with a different point, so a separate simile."@en ;
    dho:citedBy dho:p-sn46.13-1.1 , dho:p-sn46.13-1.2 .

dho:sim-gold a dho:Simile ;
    skos:prefLabel "the five corruptions of native gold"@en ;
    dho:image "Mendicants, there are these five corruptions of native gold. When native gold is corrupted by these it’s not pliable, workable, or radiant, but is brittle and not completely ready for working." ;
    dho:wording "In the same way, there are these five corruptions of the mind. When the mind is corrupted by these it’s not pliable, workable, or radiant. It’s brittle, and not rightly immersed in samādhi for the ending of defilements." ;
    dho:illustrates dho:FiveCorruptionsOfMind ;
    skos:note "Iron, copper, tin, lead and silver are the five corruptions of gold (1.3-1.7); the point names five corruptions of the mind (cittassa upakkilesā, 2.1), not 'hindrances'."@en ;
    dho:citedBy dho:p-sn46.33-1.1 , dho:p-sn46.33-1.3 , dho:p-sn46.33-1.4 , dho:p-sn46.33-1.5 , dho:p-sn46.33-1.6 , dho:p-sn46.33-1.7 , dho:p-sn46.33-1.8 , dho:p-sn46.33-2.1 .

dho:sim-fire-small-wet a dho:Simile ;
    skos:prefLabel "wet fuel on a small fire"@en ;
    dho:image "If they toss wet grass, cow-dung, and timber on it, spray it with water, and scatter dirt on it," ;
    dho:wording "In the same way, when the mind is sluggish, it’s the wrong time to develop the awakening factors of tranquility, immersion, and equanimity." ;
    dho:illustrates dho:ta-01 , dho:ta-02 , dho:ta-03 ;
    skos:note "Making a small fire flare up with wet fuel, water and dirt: the sluggish mind and the wrong factors."@en ;
    dho:citedBy dho:p-sn46.53-5.1 , dho:p-sn46.53-5.2 , dho:p-sn46.53-5.3 , dho:p-sn46.53-6.1 .

dho:sim-fire-small-dry a dho:Simile ;
    skos:prefLabel "dry fuel on a small fire"@en ;
    dho:image "If they toss dry grass, cow-dung, and timber on it, blow on it, and don’t scatter dirt on it," ;
    dho:wording "In the same way, when the mind is sluggish, it’s the right time to develop the awakening factors of investigation of principles, energy, and rapture." ;
    dho:illustrates dho:ta-04 , dho:ta-05 , dho:ta-06 ;
    skos:note "Making a small fire flare up with dry fuel and blowing on it: the sluggish mind and the right factors."@en ;
    dho:citedBy dho:p-sn46.53-8.1 , dho:p-sn46.53-8.2 , dho:p-sn46.53-8.3 , dho:p-sn46.53-9.1 .

dho:sim-fire-great-dry a dho:Simile ;
    skos:prefLabel "dry fuel on a great fire"@en ;
    dho:image "If they toss dry grass, cow-dung, and timber on it, blow on it, and don’t scatter dirt on it," ;
    dho:wording "In the same way, when the mind is restless, it’s the wrong time to develop the awakening factors of investigation of principles, energy, and rapture." ;
    dho:illustrates dho:ta-07 , dho:ta-08 , dho:ta-09 ;
    skos:note "Trying to put out a great fire with dry fuel and blowing on it: the restless mind and the wrong factors."@en ;
    dho:citedBy dho:p-sn46.53-11.1 , dho:p-sn46.53-11.2 , dho:p-sn46.53-11.3 , dho:p-sn46.53-12.1 .

dho:sim-fire-great-wet a dho:Simile ;
    skos:prefLabel "wet fuel on a great fire"@en ;
    dho:image "If they toss wet grass, cow-dung, and timber on it, spray it with water, and scatter dirt on it," ;
    dho:wording "In the same way, when the mind is restless, it’s the right time to develop the awakening factors of tranquility, immersion, and equanimity." ;
    dho:illustrates dho:ta-10 , dho:ta-11 , dho:ta-12 ;
    skos:note "Putting out a great fire with wet fuel, water and dirt: the restless mind and the right factors."@en ;
    dho:citedBy dho:p-sn46.53-14.1 , dho:p-sn46.53-14.2 , dho:p-sn46.53-14.3 , dho:p-sn46.53-15.1 .

