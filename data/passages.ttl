    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:22.2" ;
    dho:textEn "There is tranquility of the body and of the mind."@en ;
    dho:textPi "Atthi, bhikkhave, kāyappassaddhi cittappassaddhi."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:22.2"^^xsd:anyURI .

