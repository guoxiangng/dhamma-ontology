    dho:part dho:TranquilityMental,
        dho:TranquilityPhysical ;
    dho:wording "Physical tranquility is the awakening factor of tranquility; and mental tranquility is also the awakening factor of tranquility." .

dho:dv-11 a owl:Thing,
        dho:Division ;
    owl:sameAs dho:dv-11 ;
    dho:basis dho:WithWithoutPlacing ;
    dho:citedBy dho:p-sn46.52-10.1,
