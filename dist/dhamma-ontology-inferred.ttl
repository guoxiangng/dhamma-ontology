dho:c-15 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-15 ;
    dho:citedBy dho:p-sn46.38-1.1,
        dho:p-sn46.38-3.4 ;
    dho:condition dho:ListeningToTeaching ;
    dho:conditioned dho:FiveHindrances ;
    dho:relation dho:WhenThen ;
    dho:result dho:IsAbsent ;
    dho:wording "pays attention, applies the mind, concentrates wholeheartedly, and actively listens to the teaching" .

