dho:c-s1 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s1 ;
    dho:citedBy dho:p-sn46.3-1.9,
        dho:p-sn46.3-2.1 ;
    dho:condition dho:RecollectingTeaching ;
    dho:conditioned dho:Mindfulness ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "as they recollect and think about that teaching" .

dho:c-s2 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s2 ;
    dho:citedBy dho:p-sn46.3-2.4,
        dho:p-sn46.3-3.1 ;
    dho:condition dho:Mindfulness ;
    dho:conditioned dho:Investigation ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they live mindfully in this way they investigate, explore, and inquire into that teaching with wisdom" .

dho:c-s3 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s3 ;
    dho:citedBy dho:p-sn46.3-3.4,
        dho:p-sn46.3-4.1 ;
    dho:condition dho:Investigation ;
    dho:conditioned dho:Energy ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they investigate principles with wisdom in this way their energy is roused up and unflagging" .

dho:c-s4 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s4 ;
    dho:citedBy dho:p-sn46.3-4.2,
        dho:p-sn46.3-5.1 ;
    dho:condition dho:Energy ;
    dho:conditioned dho:Rapture ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "rapture not of the flesh arises" .

dho:c-s5 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s5 ;
    dho:citedBy dho:p-sn46.3-5.2,
        dho:p-sn46.3-6.1 ;
    dho:condition dho:Rapture ;
    dho:conditioned dho:Tranquility ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the mind is full of rapture, the body and mind become tranquil" .

dho:c-s6 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s6 ;
    skos:note "Together with bliss: 'when the body is tranquil and one feels bliss'."@en ;
    dho:citedBy dho:p-sn46.3-6.2,
        dho:p-sn46.3-7.1 ;
    dho:condition dho:Tranquility ;
    dho:conditioned dho:Immersion ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the body is tranquil and one feels bliss, the mind becomes immersed in samādhi" .

dho:c-s7 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s7 ;
    dho:citedBy dho:p-sn46.3-7.2,
        dho:p-sn46.3-8.1 ;
    dho:condition dho:Immersion ;
    dho:conditioned dho:Equanimity ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "They closely watch over that mind immersed in samādhi" .

dho:c-u1 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-u1 ;
    skos:note "Pali: 'these seven awakening factors, developed and cultivated, arise unarisen, not apart from (nāññatra) the appearance of a Realized One'. 'To be developed and cultivated' is Sujato's reading of bhāvitā bahulīkatā. A necessary condition, not a sufficient one (D23)."@en ;
    dho:citedBy dho:p-sn46.9-1.1,
        dho:p-sn46.9-1.4 ;
    dho:condition dho:AppearanceOfRealizedOne ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:RequiredFor ;
    dho:result dho:Arises ;
    dho:wording "don’t arise to be developed and cultivated except when a Realized One, a perfected one, a fully awakened Buddha has appeared" .

dho:c-u2 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-u2 ;
    skos:note "Same form as SN 46.9 (c-u1), with the Holy One's training (sugatavinaya) in place of the appearance of a Realized One."@en ;
    dho:citedBy dho:p-sn46.10-1.1,
        dho:p-sn46.10-1.4 ;
    dho:condition dho:SugataVinaya ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:RequiredFor ;
    dho:result dho:Arises ;
    dho:wording "don’t arise to be developed and cultivated apart from the Holy One’s training" .

