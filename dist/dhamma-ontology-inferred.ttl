    dho:divides dho:Immersion ;
    dho:part dho:ImmersionWithPlacing,
        dho:ImmersionWithoutPlacing ;
    dho:wording "Immersion while placing the mind and keeping it connected is the awakening factor of immersion; and immersion without placing the mind and keeping it connected is also the awakening factor of immersion." .

dho:dv-12 a owl:Thing,
        dho:Division ;
    owl:sameAs dho:dv-12 ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-16.1,
        dho:p-sn46.52-16.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Equanimity ;
