dho:p-mn10-36.2 a owl:Thing,
        dho:Passage ;
    owl:sameAs dho:p-mn10-36.2 ;
    skos:note "Sense of dhamma here is contested; deliberately left unassigned in v0.1."@en ;
    dho:inText dho:t-mn10 ;
    dho:segment "mn10:36.2" ;
    dho:textEn "It’s when a mendicant meditates by observing an aspect of principles with respect to the five hindrances."@en ;
    dho:textPi "Idha, bhikkhave, bhikkhu dhammesu dhammānupassī viharati pañcasu nīvaraṇesu."@pi ;
    dho:translatorRendering "principles (Sujato)" ;
    dho:url "https://suttacentral.net/mn10/en/sujato#mn10:36.2"^^xsd:anyURI .

