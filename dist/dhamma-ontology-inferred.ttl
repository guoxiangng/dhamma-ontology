dho:c-a1 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-a1 ;
    skos:note "When the heart is overcome and mired in each hindrance, without truly knowing and seeing the escape from it. Given in full for sensual desire, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-2.3,
        dho:p-sn46.56-2.4,
        dho:p-sn46.56-3.4,
        dho:p-sn46.56-3.5 ;
    dho:condition dho:FiveHindrances ;
    dho:conditioned dho:NotKnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for not knowing and not seeing" .

dho:c-a2 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-a2 ;
    skos:note "They truly know and see with a mind that has developed each awakening factor. Given in full for mindfulness, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-5.4,
        dho:p-sn46.56-5.5,
        dho:p-sn46.56-6.3,
        dho:p-sn46.56-6.4 ;
    dho:condition dho:SevenAwakeningFactors ;
    dho:conditioned dho:KnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for knowing and seeing" .

