dho:t-sn46.2 a owl:Thing,
        dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    owl:sameAs dho:t-sn46.2 ;
    skos:prefLabel "SN 46.2 Kāyasutta — The Body"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Its 12 statements of what fuels the five hindrances and seven awakening factors (2-6, 9-15). They match SN 46.51 sections 1-12 (identical English; Pali differs only in punctuation and one spelling variant), so they were added as a second citation on the same claims, not as new claims." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "The simile framing the teaching: as the body is sustained by food, so the hindrances and the awakening factors are sustained by fuel (1.2-1.3, 7, 8, 16). There is no pattern for similes yet." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato"^^xsd:anyURI .

owl:ObjectProperty owl:sameAs owl:ObjectProperty .

dho:Nutriment a owl:Class ;
    rdfs:label "Nutriment"@en,
        "āhāra"@pi,
        "食"@zh ;
    rdfs:comment "One statement from SN 46.51: an object, a mode of attention, and the quality it fuels or starves."@en ;
    rdfs:subClassOf owl:Thing,
        dho:Nutriment ;
    owl:equivalentClass dho:Nutriment ;
    owl:sameAs dho:Nutriment .

dho:MentalQuality a owl:Class ;
    rdfs:label "Mental quality"@en ;
    rdfs:comment "A quality of mind that can arise, grow, or be abandoned."@en ;
