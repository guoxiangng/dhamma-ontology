        dho:AttentionObject,
        dho:Concept ;
    owl:sameAs dho:o-metta ;
    skos:prefLabel "the heart's release by love"@en,
        "mettācetovimutti"@pi .

dho:o-settled-mind a owl:Thing,
        skos:Concept,
