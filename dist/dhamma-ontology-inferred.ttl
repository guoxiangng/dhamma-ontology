    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:6.2"^^xsd:anyURI .

dho:p-sn46.51-6.3 a owl:Thing,
        dho:Passage ;
    owl:sameAs dho:p-sn46.51-6.3 ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:6.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:6.3"^^xsd:anyURI .

dho:p-sn46.51-7.3 a owl:Thing,
