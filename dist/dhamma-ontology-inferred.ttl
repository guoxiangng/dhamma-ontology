ontolex:Form owl:sameAs ontolex:Form .

ontolex:LexicalEntry owl:sameAs ontolex:LexicalEntry .

ontolex:Word owl:sameAs ontolex:Word .

dho:AlwaysUseful a owl:Thing,
        dho:Timing ;
    rdfs:label "always useful"@en,
        "sabbatthika"@pi ;
    owl:sameAs dho:AlwaysUseful .

dho:DhammaMindObject a owl:Thing,
        skos:Concept,
        dho:Concept ;
    owl:sameAs dho:DhammaMindObject ;
    skos:definition "What the mind knows, as the sixth sense field alongside sights, sounds, smells, tastes and touches (dhammāyatana)."@en ;
    skos:prefLabel "a dhamma (an object of the mind, an idea)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaPhenomenon a owl:Thing,
        skos:Concept,
        dho:Concept ;
    owl:sameAs dho:DhammaPhenomenon ;
    skos:definition "Any thing at all, as in 'all things are not-self' (sabbe dhammā anattā)."@en ;
    skos:prefLabel "a dhamma (any phenomenon, any thing)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaQuality a owl:Thing,
        skos:Concept,
        dho:Concept ;
    owl:sameAs dho:DhammaQuality ;
    skos:definition "A quality of mind, e.g. 'qualities that are skillful and unskillful' (kusalākusalā dhammā)."@en ;
    skos:prefLabel "a dhamma (a mental quality)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaTeaching a owl:Thing,
        skos:Concept,
        dho:Concept ;
    owl:sameAs dho:DhammaTeaching ;
    skos:definition "The teaching the Buddha explained: 'the teaching is well explained by the Buddha' (svākkhāto bhagavatā dhammo)."@en ;
    skos:prefLabel "the Dhamma (the Buddha's teaching)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:FullyEncoded a owl:Thing,
        dho:CoverageStatus ;
    rdfs:label "fully encoded"@en ;
    rdfs:comment "Every teaching claim in the text is modelled."@en ;
    owl:sameAs dho:FullyEncoded .

dho:ReferencedOnly a owl:Thing,
        dho:CoverageStatus ;
    rdfs:label "referenced only"@en ;
    rdfs:comment "Cited by reference; we do not hold its text, so its claims are unverified."@en ;
    owl:sameAs dho:ReferencedOnly .

