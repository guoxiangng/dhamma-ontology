        dho:Concept ;
    owl:sameAs dho:o-grounds-doubt ;
    skos:prefLabel "things that are grounds for doubt"@en,
        "vicikicchāṭṭhānīyā dhammā"@pi .

dho:o-metta a owl:Thing,
