    dho:conditioned dho:Investigation ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they live mindfully in this way they investigate, explore, and inquire into that teaching with wisdom" .

dho:c-s3 a owl:Thing,
        dho:Condition ;
    owl:sameAs dho:c-s3 ;
    dho:citedBy dho:p-sn46.3-3.4,
        dho:p-sn46.3-4.1 ;
