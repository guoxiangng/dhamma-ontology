dho:d-r1-Energy-DullnessDrowsiness a dho:Derivation ;
    dho:derivedBy "R1" ;
    dho:derivedObject dho:DullnessDrowsiness ;
    dho:derivedSubject dho:Energy ;
    dho:via dho:n-08,
        dho:n-15,
        dho:o-energy-elements .

dho:d-r1-Investigation-Doubt a dho:Derivation ;
    dho:derivedBy "R1" ;
    dho:derivedObject dho:Doubt ;
    dho:derivedSubject dho:Investigation ;
    dho:via dho:n-07,
        dho:n-17,
        dho:o-qualities .

