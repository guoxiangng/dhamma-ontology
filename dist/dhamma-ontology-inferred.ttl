        dho:AttentionObject,
        dho:Concept ;
    owl:sameAs dho:o-beauty ;
    skos:prefLabel "the feature of beauty"@en,
        "subhanimitta"@pi .

dho:o-grounds-doubt a owl:Thing,
        skos:Concept,
