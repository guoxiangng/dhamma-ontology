dho:t-sn46.38 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.38 Anīvaraṇasutta — Without Obstacles"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Both lists, as citations on the existing lists (2.1, 2.2; 3.1, 3.2)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "The teaching itself: when a noble disciple pays attention, applies the mind, concentrates wholeheartedly and actively listens to the teaching, the five hindrances are absent and the seven awakening factors are fully developed (1.1, 3.4). Needs a pattern for conditions." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato"^^xsd:anyURI .

dho:t-sn46.40 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.40 Nīvaraṇasutta — Hindrances"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Both lists, as citations on the existing lists (1.1, 1.3; 2.1, 2.3)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "What the sutta says about them: the hindrances destroy sight, vision and knowledge, block wisdom, are on the side of distress and don't lead to extinguishment; the awakening factors are the opposite (1.1, 1.8, 2.1, 2.4). Also the chapter's summary verse (3.0-3.4). Needs a pattern for what a quality does or leads to." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato"^^xsd:anyURI .

