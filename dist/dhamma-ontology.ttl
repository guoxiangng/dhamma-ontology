        dho:p-sn46.49-1.4,
        dho:p-sn46.49-1.5,
        dho:p-sn46.5-1.7,
        dho:p-sn46.50-1.4,
        dho:p-sn46.50-1.5,
        dho:p-sn46.56-5.3,
        dho:p-sn46.56-6.2,
        dho:p-sn46.57-1.5,
        dho:p-sn46.7-2.3,
        dho:p-sn46.76-1.4,
        dho:p-sn46.76-2.6,
        dho:p-sn46.76-3.4 ;
    dho:condition dho:Cessation ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:BasisOf ;
    dho:wording "on seclusion, fading away, and cessation" .

dho:c-a1 a dho:Condition ;
    skos:note "When the heart is overcome and mired in each hindrance, without truly knowing and seeing the escape from it. Given in full for sensual desire, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-1.10,
        dho:p-sn46.56-1.11,
        dho:p-sn46.56-2.3,
        dho:p-sn46.56-2.4,
        dho:p-sn46.56-3.4,
        dho:p-sn46.56-3.5 ;
    dho:condition dho:FiveHindrances ;
    dho:conditioned dho:NotKnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for not knowing and not seeing" .

dho:c-a2 a dho:Condition ;
    skos:note "They truly know and see with a mind that has developed each awakening factor. Given in full for mindfulness, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-1.12,
        dho:p-sn46.56-1.13,
        dho:p-sn46.56-5.4,
        dho:p-sn46.56-5.5,
        dho:p-sn46.56-6.3,
        dho:p-sn46.56-6.4 ;
    dho:condition dho:SevenAwakeningFactors ;
    dho:conditioned dho:KnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for knowing and seeing" .

dho:c-p57 a dho:Condition ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of a skeleton. Sujato's English: 'develops the perception of a skeleton together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.57-1.4,
        dho:p-sn46.57-1.5,
        dho:p-sn46.57-2.3,
        dho:p-sn46.57-2.4,
        dho:p-sn46.57-3.3,
        dho:p-sn46.57-3.4,
        dho:p-sn46.57-4.3,
        dho:p-sn46.57-4.4,
        dho:p-sn46.57-5.3,
        dho:p-sn46.57-5.4,
        dho:p-sn46.57-6.3,
        dho:p-sn46.57-6.4 ;
    dho:condition dho:SkeletonPerception ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "aṭṭhikasaññāsahagataṁ" .

dho:c-p76 a dho:Condition ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of cessation. Sujato's English: 'develops the perception of cessation together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.76-1.3,
        dho:p-sn46.76-1.4,
        dho:p-sn46.76-2.5,
        dho:p-sn46.76-2.6,
        dho:p-sn46.76-3.3,
        dho:p-sn46.76-3.4 ;
    dho:condition dho:CessationPerception ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "nirodhasaññāsahagataṁ" .

dho:c-s1 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-1.9,
        dho:p-sn46.3-2.1 ;
    dho:condition dho:RecollectingTeaching ;
    dho:conditioned dho:Mindfulness ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "as they recollect and think about that teaching" .

dho:c-s2 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-2.4,
        dho:p-sn46.3-3.1 ;
    dho:condition dho:Mindfulness ;
    dho:conditioned dho:Investigation ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they live mindfully in this way they investigate, explore, and inquire into that teaching with wisdom" .

dho:c-s3 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-3.4,
        dho:p-sn46.3-4.1 ;
    dho:condition dho:Investigation ;
    dho:conditioned dho:Energy ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they investigate principles with wisdom in this way their energy is roused up and unflagging" .

dho:c-s4 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-4.2,
        dho:p-sn46.3-5.1 ;
    dho:condition dho:Energy ;
    dho:conditioned dho:Rapture ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "rapture not of the flesh arises" .

dho:c-s5 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-5.2,
        dho:p-sn46.3-6.1 ;
    dho:condition dho:Rapture ;
    dho:conditioned dho:Tranquility ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the mind is full of rapture, the body and mind become tranquil" .

dho:c-s6 a dho:Condition ;
    skos:note "Together with bliss: 'when the body is tranquil and one feels bliss'."@en ;
    dho:citedBy dho:p-sn46.3-6.2,
        dho:p-sn46.3-7.1 ;
    dho:condition dho:Tranquility ;
    dho:conditioned dho:Immersion ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the body is tranquil and one feels bliss, the mind becomes immersed in samādhi" .

dho:c-s7 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-7.2,
        dho:p-sn46.3-8.1 ;
    dho:condition dho:Immersion ;
    dho:conditioned dho:Equanimity ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "They closely watch over that mind immersed in samādhi" .

dho:citationNote a owl:DatatypeProperty ;
    rdfs:label "citation note"@en ;
    rdfs:comment "Free-text reference for sources we do not hold verbatim (e.g. Visuddhimagga). Claims that only have this are flagged as unverified."@en .

dho:citedBy a owl:ObjectProperty ;
    rdfs:label "cited by"@en ;
    rdfs:comment "The passage(s) that state this claim."@en ;
    rdfs:range dho:Passage .

dho:condition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "condition"@en ;
    rdfs:domain dho:Condition .

dho:conditioned a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "conditioned"@en ;
    rdfs:domain dho:Condition .

dho:counters a owl:ObjectProperty ;
    rdfs:label "counters"@en ;
    rdfs:comment "Derived by rule R1: the same object, attended to rationally, both fuels this awakening factor and starves that hindrance (SN 46.51). The sutta never states it directly."@en ;
    rdfs:domain dho:AwakeningFactor ;
    rdfs:range dho:Hindrance .

dho:coverage a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "coverage"@en ;
    rdfs:domain dho:Text ;
    rdfs:range dho:CoverageStatus .

dho:def-01 a dho:Definition ;
    dho:as dho:Immersion ;
    dho:citedBy dho:p-mn44-12.2 ;
    dho:defines dho:Unification .

dho:defines a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "defines"@en ;
    rdfs:domain dho:Definition ;
    rdfs:range dho:Concept .

dho:derivedBy a owl:DatatypeProperty ;
    rdfs:label "derived by rule"@en ;
    rdfs:domain dho:Derivation .

dho:derivedObject a owl:ObjectProperty ;
    rdfs:label "derived object"@en ;
    rdfs:domain dho:Derivation .

dho:derivedSubject a owl:ObjectProperty ;
    rdfs:label "derived subject"@en ;
    rdfs:domain dho:Derivation .

dho:develop a owl:ObjectProperty ;
    rdfs:label "develop"@en ;
    rdfs:domain dho:TimingAdvice ;
    rdfs:range dho:AwakeningFactor .

dho:divides a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "divides"@en ;
    rdfs:domain dho:Division .

dho:dv-01 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-9.1,
        dho:p-sn46.52-9.12,
        dho:p-sn46.52-9.2,
        dho:p-sn46.52-9.3 ;
    dho:divides dho:SensualDesire ;
    dho:part dho:SensualDesireExternal,
        dho:SensualDesireInternal ;
    dho:wording "Sensual desire for what is internal is a hindrance; and sensual desire for what is external is also a hindrance." .

dho:dv-02 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-9.1,
        dho:p-sn46.52-9.12,
        dho:p-sn46.52-9.4,
        dho:p-sn46.52-9.5 ;
    dho:divides dho:IllWill ;
    dho:part dho:IllWillExternal,
        dho:IllWillInternal ;
    dho:wording "Ill will for what is internal is a hindrance; and ill will for what is external is also a hindrance." .

dho:dv-03 a dho:Division ;
    dho:basis dho:NamedParts ;
    dho:citedBy dho:p-sn46.52-9.1,
        dho:p-sn46.52-9.12,
        dho:p-sn46.52-9.6,
        dho:p-sn46.52-9.7 ;
    dho:divides dho:DullnessDrowsiness ;
    dho:part dho:Drowsiness,
        dho:Dullness ;
    dho:wording "Dullness is a hindrance; and drowsiness is also a hindrance." .

dho:dv-04 a dho:Division ;
    dho:basis dho:NamedParts ;
    dho:citedBy dho:p-sn46.52-9.1,
        dho:p-sn46.52-9.12,
        dho:p-sn46.52-9.8,
        dho:p-sn46.52-9.9 ;
    dho:divides dho:RestlessnessRemorse ;
    dho:part dho:Remorse,
        dho:Restlessness ;
    dho:wording "Restlessness is a hindrance; and remorse is also a hindrance." .

dho:dv-05 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-9.1,
        dho:p-sn46.52-9.10,
        dho:p-sn46.52-9.11,
        dho:p-sn46.52-9.12 ;
    dho:divides dho:Doubt ;
    dho:part dho:DoubtExternal,
        dho:DoubtInternal ;
    dho:wording "Doubt about internal things is a hindrance; and doubt about external things is also a hindrance." .

dho:dv-06 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-10.2,
        dho:p-sn46.52-10.3,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Mindfulness ;
    dho:part dho:MindfulnessExternal,
        dho:MindfulnessInternal ;
    dho:wording "Mindfulness of internal things is the awakening factor of mindfulness; and mindfulness of external things is also the awakening factor of mindfulness." .

dho:dv-07 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-11.1,
        dho:p-sn46.52-11.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Investigation ;
    dho:part dho:InvestigationExternal,
        dho:InvestigationInternal ;
    dho:wording "Investigating, exploring, and inquiring into internal things with wisdom is the awakening factor of investigation of principles; and investigating, exploring, and inquiring into external things with wisdom is also the awakening factor of investigation of principles." .

dho:dv-08 a dho:Division ;
    dho:basis dho:PhysicalMental ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-12.1,
        dho:p-sn46.52-12.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Energy ;
    dho:part dho:EnergyMental,
        dho:EnergyPhysical ;
    dho:wording "Physical energy is the awakening factor of energy; and mental energy is also the awakening factor of energy." .

dho:dv-09 a dho:Division ;
    dho:basis dho:WithWithoutPlacing ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-13.1,
        dho:p-sn46.52-13.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Rapture ;
    dho:part dho:RaptureWithPlacing,
        dho:RaptureWithoutPlacing ;
    dho:wording "Rapture while placing the mind and keeping it connected is the awakening factor of rapture; and rapture without placing the mind and keeping it connected is also the awakening factor of rapture." .

dho:dv-10 a dho:Division ;
    dho:basis dho:PhysicalMental ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-14.1,
        dho:p-sn46.52-14.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Tranquility ;
    dho:part dho:TranquilityMental,
        dho:TranquilityPhysical ;
    dho:wording "Physical tranquility is the awakening factor of tranquility; and mental tranquility is also the awakening factor of tranquility." .

dho:dv-11 a dho:Division ;
    dho:basis dho:WithWithoutPlacing ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-15.1,
        dho:p-sn46.52-15.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Immersion ;
    dho:part dho:ImmersionWithPlacing,
        dho:ImmersionWithoutPlacing ;
    dho:wording "Immersion while placing the mind and keeping it connected is the awakening factor of immersion; and immersion without placing the mind and keeping it connected is also the awakening factor of immersion." .

dho:dv-12 a dho:Division ;
    dho:basis dho:InternalExternal ;
    dho:citedBy dho:p-sn46.52-10.1,
        dho:p-sn46.52-16.1,
        dho:p-sn46.52-16.2,
        dho:p-sn46.52-16.3 ;
    dho:divides dho:Equanimity ;
    dho:part dho:EquanimityExternal,
        dho:EquanimityInternal ;
    dho:wording "Equanimity for internal things is the awakening factor of equanimity; and equanimity for external things is also the awakening factor of equanimity." .

dho:editorialRelated a owl:ObjectProperty ;
    rdfs:label "related (editor's judgment)"@en ;
    rdfs:comment "A link this project draws that no text states outright. Always shown as the editor's view."@en ;
    rdfs:subPropertyOf skos:related .

dho:effect a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "effect"@en ;
    rdfs:domain dho:Outcome ;
    rdfs:range dho:Effect .

dho:encodes a owl:DatatypeProperty ;
    rdfs:label "encodes"@en ;
    rdfs:comment "Plain description of what was modelled from this text."@en ;
    rdfs:domain dho:Text .

dho:expectedCount a owl:DatatypeProperty ;
    rdfs:label "expected count"@en ;
    rdfs:comment "How many members the text says the list has. SHACL checks the data matches."@en ;
    rdfs:domain dho:NumberedList ;
    rdfs:range xsd:integer .

dho:fuels a owl:ObjectProperty ;
    rdfs:label "fuels"@en ;
    rdfs:comment "Makes the quality arise, or increase once arisen (āhāra)."@en ;
    rdfs:domain dho:Nutriment ;
    rdfs:range dho:MentalQuality .

dho:givesUp a owl:ObjectProperty ;
    rdfs:label "has given up"@en,
        "vippahīna"@pi ;
    rdfs:domain dho:Attainment ;
    rdfs:range dho:NumberedList .

dho:inText a owl:ObjectProperty ;
    rdfs:label "in text"@en ;
    rdfs:domain dho:Passage ;
    rdfs:range dho:Text .

dho:layer a owl:ObjectProperty ;
    rdfs:label "layer"@en ;
    rdfs:comment "Which source layer a text or claim belongs to."@en .

dho:leftOut a owl:DatatypeProperty ;
    rdfs:label "left out"@en ;
    rdfs:comment "Plain description of what in this text is NOT modelled, so nobody mistakes partial for complete."@en ;
    rdfs:domain dho:Text .

dho:lex-dhamma a ontolex:LexicalEntry,
        ontolex:Word ;
    skos:note "Sanskrit dharma; Chinese 法. Kept as one Pali entry for v0.1."@en ;
    ontolex:canonicalForm [ a ontolex:Form ;
            ontolex:writtenRep "dhamma"@pi ] ;
    ontolex:sense dho:sense-dhamma-mind-object,
        dho:sense-dhamma-phenomenon,
        dho:sense-dhamma-quality,
        dho:sense-dhamma-teaching .

dho:modelledBy a owl:DatatypeProperty ;
    rdfs:label "modelled by"@en ;
    rdfs:domain dho:Text .

dho:modelledOn a owl:DatatypeProperty ;
    rdfs:label "modelled on"@en ;
    rdfs:domain dho:Text ;
    rdfs:range xsd:date .

