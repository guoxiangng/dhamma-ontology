    skos:prefLabel "physical tranquility"@en,
        "kāyappassaddhi"@pi .

dho:UglinessPerception a dho:Practice ;
    skos:prefLabel "the perception of ugliness"@en,
        "asubhasaññā"@pi ;
    dho:editorialRelated dho:o-ugliness .

dho:WorldDissatisfactionPerception a dho:Practice ;
    skos:prefLabel "the perception of dissatisfaction with the whole world"@en,
        "sabbaloke anabhiratisaññā"@pi .

dho:WormInfestedPerception a dho:Practice ;
    skos:prefLabel "the perception of a worm-infested corpse"@en,
        "puḷavakasaññā"@pi .

dho:hasMember a owl:ObjectProperty ;
    rdfs:label "has member"@en ;
    rdfs:domain dho:NumberedList ;
    rdfs:range dho:Concept ;
    rdfs:subPropertyOf skos:member .

dho:o-aversion a dho:AttentionObject ;
    skos:prefLabel "the feature of aversion"@en,
        "paṭighanimitta"@pi .

dho:o-beauty a dho:AttentionObject ;
    skos:prefLabel "the feature of beauty"@en,
        "subhanimitta"@pi .

dho:o-grounds-doubt a dho:AttentionObject ;
    skos:prefLabel "things that are grounds for doubt"@en,
        "vicikicchāṭṭhānīyā dhammā"@pi .

dho:o-settled-mind a dho:AttentionObject ;
    skos:prefLabel "the settled mind"@en,
        "cetaso vūpasamo"@pi .

dho:o-sluggishness a dho:AttentionObject ;
    skos:prefLabel "discontent, sloth, yawning, sleepiness after eating, and mental sluggishness"@en,
        "arati tandi vijambhitā bhattasammado cetaso ca līnattaṁ"@pi .

dho:o-unsettled-mind a dho:AttentionObject ;
    skos:prefLabel "the unsettled mind"@en,
        "cetaso avūpasamo"@pi .

dho:p-dhp279-1 a dho:Passage ;
    dho:inText dho:t-dhp279 ;
    dho:segment "dhp279:1" ;
    dho:textEn "All things are not-self—"@en ;
    dho:textPi "“Sabbe dhammā anattā”ti,"@pi ;
    dho:url "https://suttacentral.net/dhp279/en/sujato#dhp279:1"^^xsd:anyURI .

dho:p-mn148-5.3 a dho:Passage ;
    dho:inText dho:t-mn148 ;
    dho:segment "mn148:5.3" ;
    dho:textEn "There are the sense fields of sights, sounds, smells, tastes, touches, and ideas."@en ;
    dho:textPi "Rūpāyatanaṁ, saddāyatanaṁ, gandhāyatanaṁ, rasāyatanaṁ, phoṭṭhabbāyatanaṁ, dhammāyatanaṁ."@pi ;
    dho:url "https://suttacentral.net/mn148/en/sujato#mn148:5.3"^^xsd:anyURI .

dho:p-mn148-6.8 a dho:Passage ;
    dho:inText dho:t-mn148 ;
    dho:segment "mn148:6.8" ;
    dho:textEn "Mind consciousness arises dependent on the mind and ideas."@en ;
    dho:textPi "manañca paṭicca dhamme ca uppajjati manoviññāṇaṁ."@pi ;
    dho:url "https://suttacentral.net/mn148/en/sujato#mn148:6.8"^^xsd:anyURI .

dho:p-mn43-19.2 a dho:Passage ;
    dho:inText dho:t-mn43 ;
    dho:segment "mn43:19.2" ;
    dho:textEn "“The first absorption has five factors."@en ;
    dho:textPi "“Paṭhamaṁ kho, āvuso, jhānaṁ pañcaṅgikaṁ."@pi ;
    dho:url "https://suttacentral.net/mn43/en/sujato#mn43:19.2"^^xsd:anyURI .

dho:p-mn43-19.3 a dho:Passage ;
    dho:inText dho:t-mn43 ;
    dho:segment "mn43:19.3" ;
    dho:textEn "When a mendicant has entered the first absorption, placing the mind, keeping it connected, rapture, bliss, and unification of mind are present."@en ;
    dho:textPi "Idhāvuso, paṭhamaṁ jhānaṁ samāpannassa bhikkhuno vitakko ca vattati, vicāro ca pīti ca sukhañca cittekaggatā ca."@pi ;
    dho:url "https://suttacentral.net/mn43/en/sujato#mn43:19.3"^^xsd:anyURI .

dho:p-mn43-20.2 a dho:Passage ;
    dho:inText dho:t-mn43 ;
    dho:segment "mn43:20.2" ;
    dho:textEn "“The first absorption has given up five factors and possesses five factors."@en ;
    dho:textPi "“Paṭhamaṁ kho, āvuso, jhānaṁ pañcaṅgavippahīnaṁ, pañcaṅgasamannāgataṁ."@pi ;
    dho:url "https://suttacentral.net/mn43/en/sujato#mn43:20.2"^^xsd:anyURI .

dho:p-mn43-20.4 a dho:Passage ;
    dho:inText dho:t-mn43 ;
    dho:segment "mn43:20.4" ;
    dho:textEn "Placing the mind, keeping it connected, rapture, bliss, and unification of mind are present."@en ;
    dho:textPi "vitakko ca vattati, vicāro ca pīti ca sukhañca cittekaggatā ca."@pi ;
    dho:url "https://suttacentral.net/mn43/en/sujato#mn43:20.4"^^xsd:anyURI .

dho:p-mn44-12.2 a dho:Passage ;
    dho:inText dho:t-mn44 ;
    dho:segment "mn44:12.2" ;
    dho:textEn "“Unification of the mind is immersion."@en ;
    dho:textPi "“Yā kho, āvuso visākha, cittassa ekaggatā ayaṁ samādhi;"@pi ;
    dho:url "https://suttacentral.net/mn44/en/sujato#mn44:12.2"^^xsd:anyURI .

dho:p-sn11.3-10.2 a dho:Passage ;
    dho:inText dho:t-sn11.3 ;
    dho:segment "sn11.3:10.2" ;
    dho:textEn "‘The teaching is well explained by the Buddha—apparent in the present life, immediately effective, inviting inspection, relevant, so that sensible people can know it for themselves.’"@en ;
    dho:textPi "“svākkhāto bhagavatā dhammo sandiṭṭhiko akāliko ehipassiko opaneyyiko paccattaṁ veditabbo viññūhī”ti."@pi ;
    dho:url "https://suttacentral.net/sn11.3/en/sujato#sn11.3:10.2"^^xsd:anyURI .

dho:p-sn46.1-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.1 ;
    dho:segment "sn46.1:1.4" ;
    dho:textEn "In the same way, a mendicant develops and cultivates the seven awakening factors depending on and grounded on ethics, acquiring great and abundant good qualities."@en ;
    dho:textPi "evameva kho, bhikkhave, bhikkhu sīlaṁ nissāya sīle patiṭṭhāya satta bojjhaṅge bhāvento satta bojjhaṅge bahulīkaronto mahantattaṁ vepullattaṁ pāpuṇāti dhammesu."@pi ;
    dho:url "https://suttacentral.net/sn46.1/en/sujato#sn46.1:1.4"^^xsd:anyURI .

dho:p-sn46.11-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.11 ;
    dho:segment "sn46.11:1.3" ;
    dho:textEn "In the same way, a mendicant develops and cultivates the seven awakening factors depending on and grounded on ethics."@en ;
    dho:textPi "evameva kho, bhikkhave, bhikkhu sīlaṁ nissāya sīle patiṭṭhāya satta bojjhaṅge bhāveti, satta bojjhaṅge bahulīkaroti."@pi ;
    dho:url "https://suttacentral.net/sn46.11/en/sujato#sn46.11:1.3"^^xsd:anyURI .

dho:p-sn46.12-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.12 ;
    dho:segment "sn46.12:1.2" ;
    dho:textEn "In the same way, for a mendicant good friendship is the forerunner and harbinger of the arising of the seven awakening factors."@en ;
    dho:textPi "evameva kho, bhikkhave, bhikkhuno sattannaṁ bojjhaṅgānaṁ uppādāya etaṁ pubbaṅgamaṁ etaṁ nimittaṁ, yadidaṁ—kalyāṇamittatā."@pi ;
    dho:url "https://suttacentral.net/sn46.12/en/sujato#sn46.12:1.2"^^xsd:anyURI .

dho:p-sn46.12-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.12 ;
    dho:segment "sn46.12:1.3" ;
    dho:textEn "A mendicant with good friends can expect to develop and cultivate the seven awakening factors."@en ;
    dho:textPi "Kalyāṇamittassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.12/en/sujato#sn46.12:1.3"^^xsd:anyURI .

dho:p-sn46.13-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.13 ;
    dho:segment "sn46.13:1.2" ;
    dho:textEn "In the same way, for a mendicant rational application of mind is the forerunner and harbinger of the arising of the seven awakening factors."@en ;
    dho:textPi "evameva kho, bhikkhave, bhikkhuno sattannaṁ bojjhaṅgānaṁ uppādāya etaṁ pubbaṅgamaṁ etaṁ pubbanimittaṁ, yadidaṁ—yonisomanasikāro."@pi ;
    dho:url "https://suttacentral.net/sn46.13/en/sujato#sn46.13:1.2"^^xsd:anyURI .

dho:p-sn46.13-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.13 ;
    dho:segment "sn46.13:1.3" ;
    dho:textEn "A mendicant accomplished in rational application of mind can expect to develop and cultivate the seven awakening factors."@en ;
    dho:textPi "Yonisomanasikārasampannassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.13/en/sujato#sn46.13:1.3"^^xsd:anyURI .

dho:p-sn46.130-1.10 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.10" ;
    dho:textEn "“… which have freedom from death as their objective, destination, and culmination …”"@en ;
    dho:textPi "amatogadhaṁ amataparāyanaṁ amatapariyosānaṁ …"@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.10"^^xsd:anyURI .

dho:p-sn46.130-1.11 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.11" ;
    dho:textEn "“… which slant, slope, and incline to extinguishment …"@en ;
    dho:textPi "nibbānaninnaṁ nibbānapoṇaṁ nibbānapabbhāraṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.11"^^xsd:anyURI .

dho:p-sn46.130-1.12 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.12" ;
    dho:textEn "The seven awakening factors should be developed for the direct knowledge, complete understanding, finishing, and giving up of these five higher fetters.”"@en ;
    dho:textPi "Imesaṁ kho, bhikkhave, bhikkhu pañcannaṁ uddhambhāgiyānaṁ saṁyojanānaṁ abhiññāya pariññāya parikkhayāya pahānāya ime satta bojjhaṅgā bhāvetabbā”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.12"^^xsd:anyURI .

dho:p-sn46.130-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.2" ;
    dho:textEn "“Mendicants, there are five higher fetters."@en ;
    dho:textPi "“Pañcimāni, bhikkhave, uddhambhāgiyāni saṁyojanāni."@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.2"^^xsd:anyURI .

dho:p-sn46.130-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.4" ;
    dho:textEn "Desire for rebirth in the realm of luminous form, desire for rebirth in the formless realm, conceit, restlessness, and ignorance."@en ;
    dho:textPi "Rūparāgo, arūparāgo, māno, uddhaccaṁ, avijjā—"@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.4"^^xsd:anyURI .

dho:p-sn46.130-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.130 ;
    dho:segment "sn46.130:1.6" ;
    dho:textEn "The seven awakening factors should be developed for the direct knowledge, complete understanding, finishing, and giving up of these five higher fetters."@en ;
    dho:textPi "Imesaṁ kho, bhikkhave, pañcannaṁ uddhambhāgiyānaṁ saṁyojanānaṁ abhiññāya pariññāya parikkhayāya pahānāya satta bojjhaṅgā bhāvetabbā."@pi ;
    dho:url "https://suttacentral.net/sn46.130/en/sujato#sn46.130:1.6"^^xsd:anyURI .

dho:p-sn46.17-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.17 ;
    dho:segment "sn46.17:1.1" ;
    dho:textEn "“Mendicants, when these seven awakening factors are developed and cultivated they lead to going from the near shore to the far shore."@en ;
    dho:textPi "“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā apārā pāraṁ gamanāya saṁvattanti."@pi ;
    dho:url "https://suttacentral.net/sn46.17/en/sujato#sn46.17:1.1"^^xsd:anyURI .

dho:p-sn46.17-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.17 ;
    dho:segment "sn46.17:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.17/en/sujato#sn46.17:1.3"^^xsd:anyURI .

dho:p-sn46.17-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.17 ;
    dho:segment "sn46.17:1.4" ;
    dho:textEn "These seven awakening factors, when developed and cultivated, lead to going from the near shore to the far shore."@en ;
    dho:textPi "ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā apārā pāraṁ gamanāya saṁvattantīti."@pi ;
    dho:url "https://suttacentral.net/sn46.17/en/sujato#sn46.17:1.4"^^xsd:anyURI .

dho:p-sn46.19-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.19 ;
    dho:segment "sn46.19:1.1" ;
    dho:textEn "“Mendicants, when these seven awakening factors are developed and cultivated they are noble and emancipating, and bring one who practices them to the complete ending of suffering."@en ;
    dho:textPi "“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā ariyā niyyānikā nīyanti takkarassa sammā dukkhakkhayāya."@pi ;
    dho:url "https://suttacentral.net/sn46.19/en/sujato#sn46.19:1.1"^^xsd:anyURI .

dho:p-sn46.19-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.19 ;
    dho:segment "sn46.19:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.19/en/sujato#sn46.19:1.3"^^xsd:anyURI .

dho:p-sn46.19-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.19 ;
    dho:segment "sn46.19:1.4" ;
    dho:textEn "When these seven awakening factors are developed and cultivated they are noble and emancipating, and bring one who practices them to the complete ending of suffering.”"@en ;
    dho:textPi "ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā ariyā niyyānikā nīyanti takkarassa sammā dukkhakkhayāyā”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.19/en/sujato#sn46.19:1.4"^^xsd:anyURI .

dho:p-sn46.2-10.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:10.2" ;
    dho:textEn "There are qualities that are skillful and unskillful, blameworthy and blameless, inferior and superior, and those with a portion of dark or bright."@en ;
    dho:textPi "Atthi, bhikkhave, kusalākusalā dhammā, sāvajjānavajjā dhammā, hīnapaṇītā dhammā, kaṇhasukkasappaṭibhāgā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:10.2"^^xsd:anyURI .

dho:p-sn46.2-10.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:10.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:10.3"^^xsd:anyURI .

dho:p-sn46.2-10.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:10.4" ;
    dho:textEn "fuels the arising of the awakening factor of investigation of principles, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā dhammavicayasambojjhaṅgassa uppādāya, uppannassa vā dhammavicayasambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:10.4"^^xsd:anyURI .

dho:p-sn46.2-11.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:11.2" ;
    dho:textEn "There are the elements of initiative, persistence, and exertion."@en ;
    dho:textPi "Atthi, bhikkhave, ārambhadhātu nikkamadhātu parakkamadhātu."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:11.2"^^xsd:anyURI .

dho:p-sn46.2-11.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:11.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:11.3"^^xsd:anyURI .

dho:p-sn46.2-11.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:11.4" ;
    dho:textEn "fuels the arising of the awakening factor of energy, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā vīriyasambojjhaṅgassa uppādāya, uppannassa vā vīriyasambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:11.4"^^xsd:anyURI .

dho:p-sn46.2-12.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:12.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of rapture."@en ;
    dho:textPi "Atthi, bhikkhave, pītisambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:12.2"^^xsd:anyURI .

dho:p-sn46.2-12.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:12.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:12.3"^^xsd:anyURI .

dho:p-sn46.2-12.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:12.4" ;
    dho:textEn "fuels the arising of the awakening factor of rapture, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā pītisambojjhaṅgassa uppādāya, uppannassa vā pītisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:12.4"^^xsd:anyURI .

dho:p-sn46.2-13.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:13.2" ;
    dho:textEn "There is tranquility of the body and of the mind."@en ;
    dho:textPi "Atthi, bhikkhave, kāyapassaddhi, cittapassaddhi."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:13.2"^^xsd:anyURI .

dho:p-sn46.2-13.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:13.3" ;
    dho:textEn "Frequent rational application of mind to that"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:13.3"^^xsd:anyURI .

dho:p-sn46.2-13.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:13.4" ;
    dho:textEn "fuels the arising of the awakening factor of tranquility, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā passaddhisambojjhaṅgassa uppādāya, uppannassa vā passaddhisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:13.4"^^xsd:anyURI .

dho:p-sn46.2-14.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:14.2" ;
    dho:textEn "There are things that are the basis of serenity and freedom from distraction."@en ;
    dho:textPi "Atthi, bhikkhave, samathanimittaṁ abyagganimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:14.2"^^xsd:anyURI .

dho:p-sn46.2-14.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:14.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:14.3"^^xsd:anyURI .

dho:p-sn46.2-14.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:14.4" ;
    dho:textEn "fuels the arising of the awakening factor of immersion, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā samādhisambojjhaṅgassa uppādāya, uppannassa vā samādhisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:14.4"^^xsd:anyURI .

dho:p-sn46.2-15.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:15.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of equanimity."@en ;
    dho:textPi "Atthi, bhikkhave, upekkhāsambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:15.2"^^xsd:anyURI .

dho:p-sn46.2-15.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:15.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:15.3"^^xsd:anyURI .

dho:p-sn46.2-15.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:15.4" ;
    dho:textEn "fuels the arising of the awakening factor of equanimity, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā upekkhāsambojjhaṅgassa uppādāya, uppannassa vā upekkhāsambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:15.4"^^xsd:anyURI .

dho:p-sn46.2-2.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:2.2" ;
    dho:textEn "There is the feature of beauty."@en ;
    dho:textPi "Atthi, bhikkhave, subhanimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:2.2"^^xsd:anyURI .

dho:p-sn46.2-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:2.3" ;
    dho:textEn "Frequent irrational application of mind to that"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:2.3"^^xsd:anyURI .

dho:p-sn46.2-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:2.4" ;
    dho:textEn "fuels the arising of sensual desire, or, when it has arisen, makes it increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā kāmacchandassa uppādāya, uppannassa vā kāmacchandassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:2.4"^^xsd:anyURI .

dho:p-sn46.2-3.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:3.2" ;
    dho:textEn "There is the feature of aversion."@en ;
    dho:textPi "Atthi, bhikkhave, paṭighanimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:3.2"^^xsd:anyURI .

dho:p-sn46.2-3.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:3.3" ;
    dho:textEn "Frequent irrational application of mind to that"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:3.3"^^xsd:anyURI .

dho:p-sn46.2-3.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:3.4" ;
    dho:textEn "fuels the arising of ill will, or, when it has arisen, makes it increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā byāpādassa uppādāya, uppannassa vā byāpādassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:3.4"^^xsd:anyURI .

dho:p-sn46.2-4.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:4.2" ;
    dho:textEn "There is discontent, sloth, yawning, sleepiness after eating, and mental sluggishness."@en ;
    dho:textPi "Atthi, bhikkhave, arati tandi vijambhitā bhattasammado cetaso ca līnattaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:4.2"^^xsd:anyURI .

dho:p-sn46.2-4.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:4.3" ;
    dho:textEn "Frequent irrational application of mind to them"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:4.3"^^xsd:anyURI .

dho:p-sn46.2-4.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:4.4" ;
    dho:textEn "fuels the arising of dullness and drowsiness, or, when they have arisen, makes them increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā thinamiddhassa uppādāya, uppannassa vā thinamiddhassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:4.4"^^xsd:anyURI .

dho:p-sn46.2-5.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:5.2" ;
    dho:textEn "There is the unsettled mind."@en ;
    dho:textPi "Atthi, bhikkhave, cetaso avūpasamo."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:5.2"^^xsd:anyURI .

dho:p-sn46.2-5.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:5.3" ;
    dho:textEn "Frequent irrational application of mind to that"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:5.3"^^xsd:anyURI .

dho:p-sn46.2-5.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:5.4" ;
    dho:textEn "fuels the arising of restlessness and remorse, or, when they have arisen, makes them increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā uddhaccakukkuccassa uppādāya, uppannassa vā uddhaccakukkuccassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:5.4"^^xsd:anyURI .

dho:p-sn46.2-6.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:6.2" ;
    dho:textEn "There are things that are grounds for doubt."@en ;
    dho:textPi "Atthi, bhikkhave, vicikicchāṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:6.2"^^xsd:anyURI .

dho:p-sn46.2-6.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:6.3" ;
    dho:textEn "Frequent irrational application of mind to them"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:6.3"^^xsd:anyURI .

dho:p-sn46.2-6.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:6.4" ;
    dho:textEn "fuels the arising of doubt, or, when it has arisen, makes it increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannāya vā vicikicchāya uppādāya, uppannāya vā vicikicchāya bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:6.4"^^xsd:anyURI .

dho:p-sn46.2-9.2 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:9.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of mindfulness."@en ;
    dho:textPi "Atthi, bhikkhave, satisambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:9.2"^^xsd:anyURI .

dho:p-sn46.2-9.3 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:9.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:9.3"^^xsd:anyURI .

dho:p-sn46.2-9.4 a dho:Passage ;
    dho:inText dho:t-sn46.2 ;
    dho:segment "sn46.2:9.4" ;
    dho:textEn "fuels the arising of the awakening factor of mindfulness, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā satisambojjhaṅgassa uppādāya, uppannassa vā satisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato#sn46.2:9.4"^^xsd:anyURI .

dho:p-sn46.20-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.20 ;
    dho:segment "sn46.20:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.20/en/sujato#sn46.20:1.3"^^xsd:anyURI .

dho:p-sn46.21-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.21 ;
    dho:segment "sn46.21:2.3" ;
    dho:textEn "“Mendicant, they’re called awakening factors because they lead to awakening."@en ;
    dho:textPi "“‘Bodhāya saṁvattantī’ti kho, bhikkhu, tasmā bojjhaṅgāti vuccanti."@pi ;
    dho:url "https://suttacentral.net/sn46.21/en/sujato#sn46.21:2.3"^^xsd:anyURI .

dho:p-sn46.21-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.21 ;
    dho:segment "sn46.21:2.4" ;
    dho:textEn "A mendicant develops the awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion,"@en ;
    dho:textPi "Idha, bhikkhu, satisambojjhaṅgaṁ bhāveti vivekanissitaṁ …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.21/en/sujato#sn46.21:2.4"^^xsd:anyURI .

dho:p-sn46.21-2.6 a dho:Passage ;
    dho:inText dho:t-sn46.21 ;
    dho:segment "sn46.21:2.6" ;
    dho:textEn "They’re called awakening factors because they lead to awakening.”"@en ;
    dho:textPi "‘Bodhāya saṁvattantī’ti kho, bhikkhu, tasmā ‘bojjhaṅgā’ti vuccantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.21/en/sujato#sn46.21:2.6"^^xsd:anyURI .

dho:p-sn46.22-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.22 ;
    dho:segment "sn46.22:1.1" ;
    dho:textEn "“Mendicants, I will teach you the seven awakening factors."@en ;
    dho:textPi "“Satta vo, bhikkhave, bojjhaṅge desessāmi;"@pi ;
    dho:url "https://suttacentral.net/sn46.22/en/sujato#sn46.22:1.1"^^xsd:anyURI .

dho:p-sn46.22-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.22 ;
    dho:segment "sn46.22:1.3" ;
    dho:textEn "And what are the seven awakening factors?"@en ;
    dho:textPi "Katame ca, bhikkhave, satta bojjhaṅgā?"@pi ;
    dho:url "https://suttacentral.net/sn46.22/en/sujato#sn46.22:1.3"^^xsd:anyURI .

dho:p-sn46.22-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.22 ;
    dho:segment "sn46.22:1.4" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.22/en/sujato#sn46.22:1.4"^^xsd:anyURI .

dho:p-sn46.24-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:1.2" ;
    dho:textEn "ill will,"@en ;
    dho:textPi "anuppanno ceva byāpādo uppajjati, uppanno ca byāpādo bhiyyobhāvāya vepullāya saṁvattati;"@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:1.2"^^xsd:anyURI .

dho:p-sn46.24-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:1.3" ;
    dho:textEn "dullness and drowsiness,"@en ;
    dho:textPi "anuppannañceva thinamiddhaṁ uppajjati, uppannañca thinamiddhaṁ bhiyyobhāvāya vepullāya saṁvattati;"@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:1.3"^^xsd:anyURI .

dho:p-sn46.24-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:1.4" ;
    dho:textEn "restlessness and remorse,"@en ;
    dho:textPi "anuppannañceva uddhaccakukkuccaṁ uppajjati, uppannañca uddhaccakukkuccaṁ bhiyyobhāvāya vepullāya saṁvattati;"@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:1.4"^^xsd:anyURI .

dho:p-sn46.24-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:1.6" ;
    dho:textEn "And the awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity don’t arise, or if they’ve already arisen, they cease."@en ;
    dho:textPi "anuppanno ceva satisambojjhaṅgo nuppajjati, uppanno ca satisambojjhaṅgo nirujjhati …pe… anuppanno ceva upekkhāsambojjhaṅgo nuppajjati, uppanno ca upekkhāsambojjhaṅgo nirujjhati."@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:1.6"^^xsd:anyURI .

dho:p-sn46.24-2.5 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:2.5" ;
    dho:textEn "and doubt don’t arise, or if they’ve already arisen they’re given up."@en ;
    dho:textPi "anuppannā ceva vicikicchā nuppajjati, uppannā ca vicikicchā pahīyati."@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:2.5"^^xsd:anyURI .

dho:p-sn46.24-3.1 a dho:Passage ;
    dho:inText dho:t-sn46.24 ;
    dho:segment "sn46.24:3.1" ;
    dho:textEn "And the awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity arise, and once they’ve arisen, they’re fully developed.”"@en ;
    dho:textPi "Anuppanno ceva satisambojjhaṅgo uppajjati, uppanno ca satisambojjhaṅgo bhāvanāpāripūriṁ gacchati …pe… anuppanno ceva upekkhāsambojjhaṅgo uppajjati, uppanno ca upekkhāsambojjhaṅgo bhāvanāpāripūriṁ gacchatī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato#sn46.24:3.1"^^xsd:anyURI .

dho:p-sn46.25-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.25 ;
    dho:segment "sn46.25:1.7" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.25/en/sujato#sn46.25:1.7"^^xsd:anyURI .

dho:p-sn46.26-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.26 ;
    dho:segment "sn46.26:1.1" ;
    dho:textEn "“Mendicants, you should develop the path and the practice that leads to the ending of craving."@en ;
    dho:textPi "“Yo, bhikkhave, maggo yā paṭipadā taṇhakkhayāya saṁvattati, taṁ maggaṁ taṁ paṭipadaṁ bhāvetha."@pi ;
    dho:url "https://suttacentral.net/sn46.26/en/sujato#sn46.26:1.1"^^xsd:anyURI .

dho:p-sn46.26-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.26 ;
    dho:segment "sn46.26:1.4" ;
    dho:textEn "It is the seven awakening factors."@en ;
    dho:textPi "satta bojjhaṅgā."@pi ;
    dho:url "https://suttacentral.net/sn46.26/en/sujato#sn46.26:1.4"^^xsd:anyURI .

dho:p-sn46.26-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.26 ;
    dho:segment "sn46.26:1.6" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity.”"@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.26/en/sujato#sn46.26:1.6"^^xsd:anyURI .

dho:p-sn46.27-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.27 ;
    dho:segment "sn46.27:1.1" ;
    dho:textEn "“Mendicants, you should develop the path and the practice that leads to the cessation of craving."@en ;
    dho:textPi "“Yo, bhikkhave, maggo yā paṭipadā taṇhānirodhāya saṁvattati, taṁ maggaṁ taṁ paṭipadaṁ bhāvetha."@pi ;
    dho:url "https://suttacentral.net/sn46.27/en/sujato#sn46.27:1.1"^^xsd:anyURI .

dho:p-sn46.27-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.27 ;
    dho:segment "sn46.27:1.4" ;
    dho:textEn "It is the seven awakening factors."@en ;
    dho:textPi "satta bojjhaṅgā."@pi ;
    dho:url "https://suttacentral.net/sn46.27/en/sujato#sn46.27:1.4"^^xsd:anyURI .

dho:p-sn46.27-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.27 ;
    dho:segment "sn46.27:1.6" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo."@pi ;
    dho:url "https://suttacentral.net/sn46.27/en/sujato#sn46.27:1.6"^^xsd:anyURI .

dho:p-sn46.27-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.27 ;
    dho:segment "sn46.27:2.3" ;
    dho:textEn "This is how the seven awakening factors are developed and cultivated so as to lead to the cessation of craving.”"@en ;
    dho:textPi "Evaṁ bhāvitā kho, bhikkhave, satta bojjhaṅgā evaṁ bahulīkatā taṇhānirodhāya saṁvattantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.27/en/sujato#sn46.27:2.3"^^xsd:anyURI .

dho:p-sn46.28-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.28 ;
    dho:segment "sn46.28:1.1" ;
    dho:textEn "“Mendicants, I will teach you a path that helps penetration."@en ;
    dho:textPi "“Nibbedhabhāgiyaṁ vo, bhikkhave, maggaṁ desessāmi;"@pi ;
    dho:url "https://suttacentral.net/sn46.28/en/sujato#sn46.28:1.1"^^xsd:anyURI .

dho:p-sn46.28-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.28 ;
    dho:segment "sn46.28:1.5" ;
    dho:textEn "It is the seven awakening factors."@en ;
    dho:textPi "satta bojjhaṅgā."@pi ;
    dho:url "https://suttacentral.net/sn46.28/en/sujato#sn46.28:1.5"^^xsd:anyURI .

dho:p-sn46.28-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.28 ;
    dho:segment "sn46.28:1.7" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity.”"@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.28/en/sujato#sn46.28:1.7"^^xsd:anyURI .

dho:p-sn46.28-1.9 a dho:Passage ;
    dho:inText dho:t-sn46.28 ;
    dho:segment "sn46.28:1.9" ;
    dho:textEn "“Sir, how are the seven awakening factors developed and cultivated so as to lead to penetration?”"@en ;
    dho:textPi "“kathaṁ bhāvitā nu kho, bhante, satta bojjhaṅgā kathaṁ bahulīkatā nibbedhāya saṁvattantī”ti?"@pi ;
    dho:url "https://suttacentral.net/sn46.28/en/sujato#sn46.28:1.9"^^xsd:anyURI .

dho:p-sn46.28-2.9 a dho:Passage ;
    dho:inText dho:t-sn46.28 ;
    dho:segment "sn46.28:2.9" ;
    dho:textEn "This is how are the seven awakening factors are developed and cultivated so as to lead to penetration.”"@en ;
    dho:textPi "Evaṁ bhāvitā kho, udāyi, satta bojjhaṅgā evaṁ bahulīkatā nibbedhāya saṁvattantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.28/en/sujato#sn46.28:2.9"^^xsd:anyURI .

dho:p-sn46.29-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.29 ;
    dho:segment "sn46.29:1.1" ;
    dho:textEn "“Mendicants, I do not see a single thing that, when it is developed and cultivated like this, leads to giving up the things that tighten the fetters like the seven awakening factors."@en ;
    dho:textPi "“Nāhaṁ, bhikkhave, aññaṁ ekadhammampi samanupassāmi, yo evaṁ bhāvito bahulīkato saṁyojanīyānaṁ dhammānaṁ pahānāya saṁvattati, yathayidaṁ, bhikkhave, satta bojjhaṅgā."@pi ;
    dho:url "https://suttacentral.net/sn46.29/en/sujato#sn46.29:1.1"^^xsd:anyURI .

dho:p-sn46.29-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.29 ;
    dho:segment "sn46.29:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo."@pi ;
    dho:url "https://suttacentral.net/sn46.29/en/sujato#sn46.29:1.3"^^xsd:anyURI .

dho:p-sn46.29-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.29 ;
    dho:segment "sn46.29:2.3" ;
    dho:textEn "That’s how the seven awakening factors are developed and cultivated so as to lead to giving up the things that tighten the fetters."@en ;
    dho:textPi "Evaṁ bhāvitā kho, bhikkhave, satta bojjhaṅgā evaṁ bahulīkatā saṁyojanīyānaṁ dhammānaṁ pahānāya saṁvattanti."@pi ;
    dho:url "https://suttacentral.net/sn46.29/en/sujato#sn46.29:2.3"^^xsd:anyURI .

dho:p-sn46.3-1.9 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:1.9" ;
    dho:textEn "as they recollect and think about that teaching."@en ;
    dho:textPi "So tathā vūpakaṭṭho viharanto taṁ dhammaṁ anussarati anuvitakketi."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:1.9"^^xsd:anyURI .

dho:p-sn46.3-2.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:2.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of mindfulness;"@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhu tathā vūpakaṭṭho viharanto taṁ dhammaṁ anussarati anuvitakketi, satisambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti;"@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:2.1"^^xsd:anyURI .

dho:p-sn46.3-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:2.4" ;
    dho:textEn "As they live mindfully in this way they investigate, explore, and inquire into that teaching with wisdom."@en ;
    dho:textPi "So tathā sato viharanto taṁ dhammaṁ paññāya pavicinati pavicarati parivīmaṁsamāpajjati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:2.4"^^xsd:anyURI .

dho:p-sn46.3-3.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:3.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of investigation of principles;"@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhu tathā sato viharanto taṁ dhammaṁ paññāya pavicinati pavicarati parivīmaṁsamāpajjati, dhammavicayasambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti;"@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:3.1"^^xsd:anyURI .

dho:p-sn46.3-3.4 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:3.4" ;
    dho:textEn "As they investigate principles with wisdom in this way their energy is roused up and unflagging."@en ;
    dho:textPi "Tassa taṁ dhammaṁ paññāya pavicinato pavicarato parivīmaṁsamāpajjato āraddhaṁ hoti vīriyaṁ asallīnaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:3.4"^^xsd:anyURI .

dho:p-sn46.3-4.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:4.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of energy; they develop it and perfect it."@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhuno taṁ dhammaṁ paññāya pavicinato pavicarato parivīmaṁsamāpajjato āraddhaṁ hoti vīriyaṁ asallīnaṁ, vīriyasambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti; vīriyasambojjhaṅgaṁ tasmiṁ samaye bhikkhu bhāveti; vīriyasambojjhaṅgo tasmiṁ samaye bhikkhuno bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:4.1"^^xsd:anyURI .

dho:p-sn46.3-4.2 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:4.2" ;
    dho:textEn "When they’re energetic, rapture not of the flesh arises."@en ;
    dho:textPi "Āraddhavīriyassa uppajjati pīti nirāmisā."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:4.2"^^xsd:anyURI .

dho:p-sn46.3-5.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:5.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of rapture; they develop it and perfect it."@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhuno āraddhavīriyassa uppajjati pīti nirāmisā, pītisambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti; pītisambojjhaṅgaṁ tasmiṁ samaye bhikkhu bhāveti; pītisambojjhaṅgo tasmiṁ samaye bhikkhuno bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:5.1"^^xsd:anyURI .

dho:p-sn46.3-5.2 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:5.2" ;
    dho:textEn "When the mind is full of rapture, the body and mind become tranquil."@en ;
    dho:textPi "Pītimanassa kāyopi passambhati, cittampi passambhati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:5.2"^^xsd:anyURI .

dho:p-sn46.3-6.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:6.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of tranquility; they develop it and perfect it."@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhuno pītimanassa kāyopi passambhati cittampi passambhati, passaddhisambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti; passaddhisambojjhaṅgaṁ tasmiṁ samaye bhikkhu bhāveti; passaddhisambojjhaṅgo tasmiṁ samaye bhikkhuno bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:6.1"^^xsd:anyURI .

dho:p-sn46.3-6.2 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:6.2" ;
    dho:textEn "When the body is tranquil and one feels bliss, the mind becomes immersed in samādhi."@en ;
    dho:textPi "Passaddhakāyassa sukhino cittaṁ samādhiyati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:6.2"^^xsd:anyURI .

dho:p-sn46.3-7.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:7.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of immersion; they develop it and perfect it."@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhuno passaddhakāyassa sukhino cittaṁ samādhiyati, samādhisambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti; samādhisambojjhaṅgaṁ tasmiṁ samaye bhikkhu bhāveti; samādhisambojjhaṅgo tasmiṁ samaye bhikkhuno bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:7.1"^^xsd:anyURI .

dho:p-sn46.3-7.2 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:7.2" ;
    dho:textEn "They closely watch over that mind immersed in samādhi."@en ;
    dho:textPi "So tathāsamāhitaṁ cittaṁ sādhukaṁ ajjhupekkhitā hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:7.2"^^xsd:anyURI .

dho:p-sn46.3-8.1 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:8.1" ;
    dho:textEn "At such a time, a mendicant has initiated the awakening factor of equanimity; they develop it and perfect it."@en ;
    dho:textPi "Yasmiṁ samaye, bhikkhave, bhikkhu tathāsamāhitaṁ cittaṁ sādhukaṁ ajjhupekkhitā hoti, upekkhāsambojjhaṅgo tasmiṁ samaye bhikkhuno āraddho hoti; upekkhāsambojjhaṅgaṁ tasmiṁ samaye bhikkhu bhāveti; upekkhāsambojjhaṅgo tasmiṁ samaye bhikkhuno bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:8.1"^^xsd:anyURI .

dho:p-sn46.3-9.2 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.2" ;
    dho:textEn "What seven?"@en ;
    dho:textPi "Katame satta phalā sattānisaṁsā?"@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.2"^^xsd:anyURI .

dho:p-sn46.3-9.3 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.3" ;
    dho:textEn "They attain enlightenment early on in this very life."@en ;
    dho:textPi "Diṭṭheva dhamme paṭikacca aññaṁ ārādheti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.3"^^xsd:anyURI .

dho:p-sn46.3-9.4 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.4" ;
    dho:textEn "If not, they attain enlightenment at the time of death."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, atha maraṇakāle aññaṁ ārādheti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.4"^^xsd:anyURI .

dho:p-sn46.3-9.5 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.5" ;
    dho:textEn "If not, with the ending of the five lower fetters, they’re extinguished between one life and the next."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, no ce maraṇakāle aññaṁ ārādheti, atha pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā antarāparinibbāyī hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.5"^^xsd:anyURI .

dho:p-sn46.3-9.6 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.6" ;
    dho:textEn "If not, with the ending of the five lower fetters they’re extinguished upon landing."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, no ce maraṇakāle aññaṁ ārādheti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā antarāparinibbāyī hoti, atha pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā upahaccaparinibbāyī hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.6"^^xsd:anyURI .

dho:p-sn46.3-9.7 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.7" ;
    dho:textEn "If not, with the ending of the five lower fetters they’re extinguished without extra effort."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, no ce maraṇakāle aññaṁ ārādheti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā antarāparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā upahaccaparinibbāyī hoti, atha pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā asaṅkhāraparinibbāyī hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.7"^^xsd:anyURI .

dho:p-sn46.3-9.8 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.8" ;
    dho:textEn "If not, with the ending of the five lower fetters they’re extinguished with extra effort."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, no ce maraṇakāle aññaṁ ārādheti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā antarāparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā upahaccaparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā asaṅkhāraparinibbāyī hoti, atha pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā sasaṅkhāraparinibbāyī hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.8"^^xsd:anyURI .

dho:p-sn46.3-9.9 a dho:Passage ;
    dho:inText dho:t-sn46.3 ;
    dho:segment "sn46.3:9.9" ;
    dho:textEn "If not, with the ending of the five lower fetters they head upstream, going to the Akaniṭṭha realm."@en ;
    dho:textPi "No ce diṭṭheva dhamme paṭikacca aññaṁ ārādheti, no ce maraṇakāle aññaṁ ārādheti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā antarāparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā upahaccaparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā asaṅkhāraparinibbāyī hoti, no ce pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā sasaṅkhāraparinibbāyī hoti, atha pañcannaṁ orambhāgiyānaṁ saṁyojanānaṁ parikkhayā uddhaṁsoto hoti akaniṭṭhagāmī."@pi ;
    dho:url "https://suttacentral.net/sn46.3/en/sujato#sn46.3:9.9"^^xsd:anyURI .

dho:p-sn46.31-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.31 ;
    dho:segment "sn46.31:1.1" ;
    dho:textEn "“Mendicants, whatever qualities are skillful, part of the skillful, on the side of the skillful, all of them are rooted in diligence and meet at diligence, and diligence is said to be the best of them."@en ;
    dho:textPi "“Ye keci, bhikkhave, dhammā kusalā kusalabhāgiyā kusalapakkhikā, sabbe te appamādamūlakā appamādasamosaraṇā; appamādo tesaṁ dhammānaṁ aggamakkhāyati."@pi ;
    dho:url "https://suttacentral.net/sn46.31/en/sujato#sn46.31:1.1"^^xsd:anyURI .

dho:p-sn46.31-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.31 ;
    dho:segment "sn46.31:1.2" ;
    dho:textEn "A mendicant who is diligent can expect to develop and cultivate the seven awakening factors."@en ;
    dho:textPi "Appamattassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.31/en/sujato#sn46.31:1.2"^^xsd:anyURI .

dho:p-sn46.32-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.32 ;
    dho:segment "sn46.32:1.1" ;
    dho:textEn "“Mendicants, whatever qualities are skillful, part of the skillful, on the side of the skillful, all of them are rooted in rational application of mind and meet at rational application of mind, and rational application of mind is said to be the best of them."@en ;
    dho:textPi "“Ye keci, bhikkhave, dhammā kusalā kusalabhāgiyā kusalapakkhikā, sabbe te yonisomanasikāramūlakā yonisomanasikārasamosaraṇā; yonisomanasikāro tesaṁ dhammānaṁ aggamakkhāyati."@pi ;
    dho:url "https://suttacentral.net/sn46.32/en/sujato#sn46.32:1.1"^^xsd:anyURI .

dho:p-sn46.32-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.32 ;
    dho:segment "sn46.32:1.2" ;
    dho:textEn "A mendicant accomplished in rational application of mind can expect to develop and cultivate the seven awakening factors."@en ;
    dho:textPi "Yonisomanasikārasampannassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.32/en/sujato#sn46.32:1.2"^^xsd:anyURI .

dho:p-sn46.33-2.1 a dho:Passage ;
    dho:inText dho:t-sn46.33 ;
    dho:segment "sn46.33:2.1" ;
    dho:textEn "In the same way, there are these five corruptions of the mind. When the mind is corrupted by these it’s not pliable, workable, or radiant. It’s brittle, and not rightly immersed in samādhi for the ending of defilements."@en ;
    dho:textPi "Evameva kho, bhikkhave, pañcime cittassa upakkilesā, yehi upakkilesehi upakkiliṭṭhaṁ cittaṁ na ceva mudu hoti na ca kammaniyaṁ, na ca pabhassaraṁ pabhaṅgu ca, na ca sammā samādhiyati āsavānaṁ khayāya."@pi ;
    dho:url "https://suttacentral.net/sn46.33/en/sujato#sn46.33:2.1"^^xsd:anyURI .

dho:p-sn46.33-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.33 ;
    dho:segment "sn46.33:2.3" ;
    dho:textEn "Sensual desire, ill will, dullness and drowsiness, restlessness and remorse, and doubt."@en ;
    dho:textPi "Kāmacchando, bhikkhave, cittassa upakkileso, yena upakkilesena upakkiliṭṭhaṁ cittaṁ na ceva mudu hoti na ca kammaniyaṁ, na ca pabhassaraṁ pabhaṅgu ca, na ca sammā samādhiyati āsavānaṁ khayāya …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.33/en/sujato#sn46.33:2.3"^^xsd:anyURI .

dho:p-sn46.33-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.33 ;
    dho:segment "sn46.33:2.4" ;
    dho:textEn "These are the five corruptions of the mind. When the mind is corrupted by these it’s not pliable, workable, or radiant. It’s brittle, and not rightly immersed in samādhi for the ending of defilements.”"@en ;
    dho:textPi "ime kho, bhikkhave, pañca cittassa upakkilesā, yehi upakkilesehi upakkiliṭṭhaṁ cittaṁ na ceva mudu hoti na ca kammaniyaṁ, na ca pabhassaraṁ pabhaṅgu ca, na ca sammā samādhiyati āsavānaṁ khayāyā”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.33/en/sujato#sn46.33:2.4"^^xsd:anyURI .

dho:p-sn46.34-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.34 ;
    dho:segment "sn46.34:1.1" ;
    dho:textEn "“Mendicants, these seven awakening factors are not obstacles, hindrances, or corruptions of the mind. When developed and cultivated they lead to the realization of the fruit of knowledge and freedom."@en ;
    dho:textPi "“Sattime, bhikkhave, bojjhaṅgā anāvaraṇā anīvaraṇā cetaso anupakkilesā bhāvitā bahulīkatā vijjāvimuttiphalasacchikiriyāya saṁvattanti."@pi ;
    dho:url "https://suttacentral.net/sn46.34/en/sujato#sn46.34:1.1"^^xsd:anyURI .

dho:p-sn46.34-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.34 ;
    dho:segment "sn46.34:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo, bhikkhave, anāvaraṇo anīvaraṇo cetaso anupakkileso bhāvito bahulīkato vijjāvimuttiphalasacchikiriyāya saṁvattati …pe… upekkhāsambojjhaṅgo, bhikkhave, anāvaraṇo anīvaraṇo cetaso anupakkileso bhāvito bahulīkato vijjāvimuttiphalasacchikiriyāya saṁvattati."@pi ;
    dho:url "https://suttacentral.net/sn46.34/en/sujato#sn46.34:1.3"^^xsd:anyURI .

dho:p-sn46.34-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.34 ;
    dho:segment "sn46.34:1.4" ;
    dho:textEn "These seven awakening factors are not obstacles, hindrances, or corruptions of the mind. When developed and cultivated they lead to the realization of the fruit of knowledge and freedom.”"@en ;
    dho:textPi "Ime kho, bhikkhave, satta bojjhaṅgā anāvaraṇā anīvaraṇā cetaso anupakkilesā bhāvitā bahulīkatā vijjāvimuttiphalasacchikiriyāya saṁvattantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.34/en/sujato#sn46.34:1.4"^^xsd:anyURI .

dho:p-sn46.35-2.1 a dho:Passage ;
    dho:inText dho:t-sn46.35 ;
    dho:segment "sn46.35:2.1" ;
    dho:textEn "“Mendicants, when you apply the mind rationally, the awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity arise, and once they’ve arisen, they’re fully developed.”"@en ;
    dho:textPi "“Yoniso ca kho, bhikkhave, manasikaroto anuppanno ceva satisambojjhaṅgo uppajjati, uppanno ca satisambojjhaṅgo bhāvanāpāripūriṁ gacchati …pe… anuppanno ceva upekkhāsambojjhaṅgo uppajjati, uppanno ca upekkhāsambojjhaṅgo bhāvanāpāripūriṁ gacchatī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.35/en/sujato#sn46.35:2.1"^^xsd:anyURI .

dho:p-sn46.36-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.36 ;
    dho:segment "sn46.36:1.1" ;
    dho:textEn "“Mendicants, when the seven awakening factors are developed and cultivated they lead to growth and progress."@en ;
    dho:textPi "“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā buddhiyā aparihānāya saṁvattanti."@pi ;
    dho:url "https://suttacentral.net/sn46.36/en/sujato#sn46.36:1.1"^^xsd:anyURI .

dho:p-sn46.36-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.36 ;
    dho:segment "sn46.36:1.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo."@pi ;
    dho:url "https://suttacentral.net/sn46.36/en/sujato#sn46.36:1.3"^^xsd:anyURI .

dho:p-sn46.36-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.36 ;
    dho:segment "sn46.36:1.4" ;
    dho:textEn "When these seven awakening factors are developed and cultivated they lead to growth and progress.”"@en ;
    dho:textPi "Ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā buddhiyā aparihānāya saṁvattantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.36/en/sujato#sn46.36:1.4"^^xsd:anyURI .

dho:p-sn46.37-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.3" ;
    dho:textEn "Sensual desire,"@en ;
    dho:textPi "Kāmacchando, bhikkhave, āvaraṇo nīvaraṇo cetaso upakkileso paññāya dubbalīkaraṇo."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.3"^^xsd:anyURI .

dho:p-sn46.37-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.4" ;
    dho:textEn "ill will,"@en ;
    dho:textPi "Byāpādo, bhikkhave, āvaraṇo nīvaraṇo cetaso upakkileso paññāya dubbalīkaraṇo."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.4"^^xsd:anyURI .

dho:p-sn46.37-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.5" ;
    dho:textEn "dullness and drowsiness,"@en ;
    dho:textPi "Thinamiddhaṁ, bhikkhave, āvaraṇaṁ nīvaraṇaṁ cetaso upakkilesaṁ paññāya dubbalīkaraṇaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.5"^^xsd:anyURI .

dho:p-sn46.37-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.6" ;
    dho:textEn "restlessness and remorse,"@en ;
    dho:textPi "Uddhaccakukkuccaṁ, bhikkhave, āvaraṇaṁ nīvaraṇaṁ cetaso upakkilesaṁ paññāya dubbalīkaraṇaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.6"^^xsd:anyURI .

dho:p-sn46.37-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.7" ;
    dho:textEn "and doubt."@en ;
    dho:textPi "Vicikicchā, bhikkhave, āvaraṇā nīvaraṇā cetaso upakkilesā paññāya dubbalīkaraṇā."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.7"^^xsd:anyURI .

dho:p-sn46.37-1.8 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:1.8" ;
    dho:textEn "These are the five obstacles and hindrances, corruptions of the heart that weaken wisdom."@en ;
    dho:textPi "Ime kho, bhikkhave, pañca āvaraṇā nīvaraṇā cetaso upakkilesā paññāya dubbalīkaraṇā."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:1.8"^^xsd:anyURI .

dho:p-sn46.37-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:2.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo, bhikkhave, anāvaraṇo anīvaraṇo cetaso anupakkileso bhāvito bahulīkato vijjāvimuttiphalasacchikiriyāya saṁvattati …pe… upekkhāsambojjhaṅgo, bhikkhave, anāvaraṇo anīvaraṇo cetaso anupakkileso bhāvito bahulīkato vijjāvimuttiphalasacchikiriyāya saṁvattati."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:2.3"^^xsd:anyURI .

dho:p-sn46.37-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.37 ;
    dho:segment "sn46.37:2.4" ;
    dho:textEn "These seven awakening factors are not obstacles, hindrances, or corruptions of the mind. When developed and cultivated they lead to the realization of the fruit of knowledge and freedom.”"@en ;
    dho:textPi "Ime kho, bhikkhave, satta bojjhaṅgā anāvaraṇā anīvaraṇā cetaso anupakkilesā bhāvitā bahulīkatā vijjāvimuttiphalasacchikiriyāya saṁvattantīti."@pi ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato#sn46.37:2.4"^^xsd:anyURI .

dho:p-sn46.38-2.1 a dho:Passage ;
    dho:inText dho:t-sn46.38 ;
    dho:segment "sn46.38:2.1" ;
    dho:textEn "What are the five hindrances that are absent?"@en ;
    dho:textPi "Katame pañca nīvaraṇā tasmiṁ samaye na honti?"@pi ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato#sn46.38:2.1"^^xsd:anyURI .

dho:p-sn46.38-2.2 a dho:Passage ;
    dho:inText dho:t-sn46.38 ;
    dho:segment "sn46.38:2.2" ;
    dho:textEn "Sensual desire, ill will, dullness and drowsiness, restlessness and remorse, and doubt."@en ;
    dho:textPi "Kāmacchandanīvaraṇaṁ tasmiṁ samaye na hoti, byāpādanīvaraṇaṁ tasmiṁ samaye na hoti, thinamiddhanīvaraṇaṁ tasmiṁ samaye na hoti, uddhaccakukkuccanīvaraṇaṁ tasmiṁ samaye na hoti, vicikicchānīvaraṇaṁ tasmiṁ samaye na hoti."@pi ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato#sn46.38:2.2"^^xsd:anyURI .

dho:p-sn46.38-3.1 a dho:Passage ;
    dho:inText dho:t-sn46.38 ;
    dho:segment "sn46.38:3.1" ;
    dho:textEn "And what are the seven awakening factors that are fully developed?"@en ;
    dho:textPi "Katame satta bojjhaṅgā tasmiṁ samaye bhāvanāpāripūriṁ gacchanti?"@pi ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato#sn46.38:3.1"^^xsd:anyURI .

dho:p-sn46.38-3.2 a dho:Passage ;
    dho:inText dho:t-sn46.38 ;
    dho:segment "sn46.38:3.2" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo tasmiṁ samaye bhāvanāpāripūriṁ gacchati …pe… upekkhāsambojjhaṅgo tasmiṁ samaye bhāvanāpāripūriṁ gacchati."@pi ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato#sn46.38:3.2"^^xsd:anyURI .

dho:p-sn46.40-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:1.3" ;
    dho:textEn "Sensual desire, ill will, dullness and drowsiness, restlessness and remorse, and doubt."@en ;
    dho:textPi "Kāmacchandanīvaraṇaṁ, bhikkhave, andhakaraṇaṁ acakkhukaraṇaṁ aññāṇakaraṇaṁ paññānirodhikaṁ vighātapakkhiyaṁ anibbānasaṁvattanikaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:1.3"^^xsd:anyURI .

dho:p-sn46.40-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:1.4" ;
    dho:textPi "Byāpādanīvaraṇaṁ, bhikkhave …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:1.4"^^xsd:anyURI .

dho:p-sn46.40-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:1.5" ;
    dho:textPi "thinamiddhanīvaraṇaṁ, bhikkhave …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:1.5"^^xsd:anyURI .

dho:p-sn46.40-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:1.6" ;
    dho:textPi "uddhaccakukkuccanīvaraṇaṁ, bhikkhave …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:1.6"^^xsd:anyURI .

dho:p-sn46.40-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:1.7" ;
    dho:textPi "vicikicchānīvaraṇaṁ, bhikkhave, andhakaraṇaṁ acakkhukaraṇaṁ aññāṇakaraṇaṁ paññānirodhikaṁ vighātapakkhiyaṁ anibbānasaṁvattanikaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:1.7"^^xsd:anyURI .

dho:p-sn46.40-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.40 ;
    dho:segment "sn46.40:2.3" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo, bhikkhave, cakkhukaraṇo ñāṇakaraṇo paññābuddhiyo avighātapakkhiyo nibbānasaṁvattaniko …pe… upekkhāsambojjhaṅgo, bhikkhave, cakkhukaraṇo ñāṇakaraṇo paññābuddhiyo avighātapakkhiyo nibbānasaṁvattaniko."@pi ;
    dho:url "https://suttacentral.net/sn46.40/en/sujato#sn46.40:2.3"^^xsd:anyURI .

dho:p-sn46.41-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.41 ;
    dho:segment "sn46.41:1.2" ;
    dho:textEn "“Mendicants, all the ascetics and brahmins in the past who have given up the three discriminations have done so by developing and cultivating the seven awakening factors."@en ;
    dho:textPi "“Ye hi keci, bhikkhave, atītamaddhānaṁ samaṇā vā brāhmaṇā vā tisso vidhā pajahiṁsu, sabbe te sattannaṁ bojjhaṅgānaṁ bhāvitattā bahulīkatattā."@pi ;
    dho:url "https://suttacentral.net/sn46.41/en/sujato#sn46.41:1.2"^^xsd:anyURI .

dho:p-sn46.41-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.41 ;
    dho:segment "sn46.41:1.3" ;
    dho:textEn "All the ascetics and brahmins in the future who will give up the three discriminations will do so by developing and cultivating the seven awakening factors."@en ;
    dho:textPi "Ye hi keci, bhikkhave, anāgatamaddhānaṁ samaṇā vā brāhmaṇā vā tisso vidhā pajahissanti, sabbe te sattannaṁ bojjhaṅgānaṁ bhāvitattā bahulīkatattā."@pi ;
    dho:url "https://suttacentral.net/sn46.41/en/sujato#sn46.41:1.3"^^xsd:anyURI .

dho:p-sn46.41-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.41 ;
    dho:segment "sn46.41:1.4" ;
    dho:textEn "All the ascetics and brahmins in the present who are giving up the three discriminations do so by developing and cultivating the seven awakening factors."@en ;
    dho:textPi "Ye hi keci, bhikkhave, etarahi samaṇā vā brāhmaṇā vā tisso vidhā pajahanti, sabbe te sattannaṁ bojjhaṅgānaṁ bhāvitattā bahulīkatattā."@pi ;
    dho:url "https://suttacentral.net/sn46.41/en/sujato#sn46.41:1.4"^^xsd:anyURI .

dho:p-sn46.41-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.41 ;
    dho:segment "sn46.41:1.6" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgassa …pe… upekkhāsambojjhaṅgassa."@pi ;
    dho:url "https://suttacentral.net/sn46.41/en/sujato#sn46.41:1.6"^^xsd:anyURI .

dho:p-sn46.41-1.9 a dho:Passage ;
    dho:inText dho:t-sn46.41 ;
    dho:segment "sn46.41:1.9" ;
    dho:textEn "and present who give up the three discriminations do so by developing and cultivating the seven awakening factors.”"@en ;
    dho:textPi "pajahanti, sabbe te imesaṁyeva sattannaṁ bojjhaṅgānaṁ bhāvitattā bahulīkatattā”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.41/en/sujato#sn46.41:1.9"^^xsd:anyURI .

dho:p-sn46.43-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.43 ;
    dho:segment "sn46.43:1.1" ;
    dho:textEn "“Mendicants, I will teach you a path for crushing Māra’s army."@en ;
    dho:textPi "“Mārasenappamaddanaṁ vo, bhikkhave, maggaṁ desessāmi;"@pi ;
    dho:url "https://suttacentral.net/sn46.43/en/sujato#sn46.43:1.1"^^xsd:anyURI .

dho:p-sn46.43-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.43 ;
    dho:segment "sn46.43:1.5" ;
    dho:textEn "It is the seven awakening factors."@en ;
    dho:textPi "satta bojjhaṅgā."@pi ;
    dho:url "https://suttacentral.net/sn46.43/en/sujato#sn46.43:1.5"^^xsd:anyURI .

dho:p-sn46.43-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.43 ;
    dho:segment "sn46.43:1.7" ;
    dho:textEn "The awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion, and equanimity."@en ;
    dho:textPi "Satisambojjhaṅgo …pe… upekkhāsambojjhaṅgo—"@pi ;
    dho:url "https://suttacentral.net/sn46.43/en/sujato#sn46.43:1.7"^^xsd:anyURI .

dho:p-sn46.43-1.8 a dho:Passage ;
    dho:inText dho:t-sn46.43 ;
    dho:segment "sn46.43:1.8" ;
    dho:textEn "This is the path for crushing Māra’s army.”"@en ;
    dho:textPi "ayaṁ kho, bhikkhave, mārasenappamaddano maggo”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.43/en/sujato#sn46.43:1.8"^^xsd:anyURI .

dho:p-sn46.48-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.48 ;
    dho:segment "sn46.48:1.2" ;
    dho:textEn "In the same way, for a mendicant good friendship is the forerunner and harbinger of the arising of the seven awakening factors."@en ;
    dho:textPi "Evameva kho, bhikkhave, bhikkhuno sattannaṁ bojjhaṅgānaṁ uppādāya etaṁ pubbaṅgamaṁ etaṁ pubbanimittaṁ, yadidaṁ—kalyāṇamittatā."@pi ;
    dho:url "https://suttacentral.net/sn46.48/en/sujato#sn46.48:1.2"^^xsd:anyURI .

dho:p-sn46.48-1.3 a dho:Passage ;
    dho:inText dho:t-sn46.48 ;
    dho:segment "sn46.48:1.3" ;
    dho:textEn "A mendicant with good friends can expect to develop and cultivate the seven awakening factors."@en ;
    dho:textPi "Kalyāṇamittassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.48/en/sujato#sn46.48:1.3"^^xsd:anyURI .

dho:p-sn46.49-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.49 ;
    dho:segment "sn46.49:1.1" ;
    dho:textEn "“Taking into account interior factors, mendicants, I do not see a single one that gives rise to the seven awakening factors like rational application of mind. …”"@en ;
    dho:textPi "“Ajjhattikaṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi sattannaṁ bojjhaṅgānaṁ uppādāya, yathayidaṁ—bhikkhave, yonisomanasikāro."@pi ;
    dho:url "https://suttacentral.net/sn46.49/en/sujato#sn46.49:1.1"^^xsd:anyURI .

dho:p-sn46.49-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.49 ;
    dho:segment "sn46.49:1.2" ;
    dho:textPi "Yonisomanasikārasampannassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.49/en/sujato#sn46.49:1.2"^^xsd:anyURI .

dho:p-sn46.49-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.49 ;
    dho:segment "sn46.49:1.6" ;
    dho:textPi "Evaṁ kho, bhikkhave, bhikkhu yonisomanasikārasampanno satta bojjhaṅge bhāveti, satta bojjhaṅge bahulīkarotī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.49/en/sujato#sn46.49:1.6"^^xsd:anyURI .

dho:p-sn46.5-1.11 a dho:Passage ;
    dho:inText dho:t-sn46.5 ;
    dho:segment "sn46.5:1.11" ;
    dho:textEn "They’re called awakening factors because they lead to awakening.”"@en ;
    dho:textPi "Bodhāya saṁvattantīti, bhikkhu, tasmā ‘bojjhaṅgā’ti vuccantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.5/en/sujato#sn46.5:1.11"^^xsd:anyURI .

dho:p-sn46.5-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.5 ;
    dho:segment "sn46.5:1.5" ;
    dho:textEn "“Mendicant, they’re called awakening factors because they lead to awakening."@en ;
    dho:textPi "“Bodhāya saṁvattantīti kho, bhikkhu, tasmā ‘bojjhaṅgā’ti vuccanti."@pi ;
    dho:url "https://suttacentral.net/sn46.5/en/sujato#sn46.5:1.5"^^xsd:anyURI .

dho:p-sn46.5-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.5 ;
    dho:segment "sn46.5:1.6" ;
    dho:textEn "A mendicant develops the awakening factors of mindfulness, investigation of principles, energy, rapture, tranquility, immersion,"@en ;
    dho:textPi "Idha, bhikkhu, satisambojjhaṅgaṁ bhāveti vivekanissitaṁ virāganissitaṁ nirodhanissitaṁ vossaggapariṇāmiṁ …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.5/en/sujato#sn46.5:1.6"^^xsd:anyURI .

dho:p-sn46.50-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.50 ;
    dho:segment "sn46.50:1.1" ;
    dho:textEn "“Taking into account exterior factors, mendicants, I do not see a single one that gives rise to the seven awakening factors like good friendship. …”"@en ;
    dho:textPi "“Bāhiraṁ, bhikkhave, aṅganti karitvā nāññaṁ ekaṅgampi samanupassāmi sattannaṁ bojjhaṅgānaṁ uppādāya, yathayidaṁ—bhikkhave, kalyāṇamittatā."@pi ;
    dho:url "https://suttacentral.net/sn46.50/en/sujato#sn46.50:1.1"^^xsd:anyURI .

dho:p-sn46.50-1.2 a dho:Passage ;
    dho:inText dho:t-sn46.50 ;
    dho:segment "sn46.50:1.2" ;
    dho:textPi "Kalyāṇamittassetaṁ, bhikkhave, bhikkhuno pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati, satta bojjhaṅge bahulīkarissati."@pi ;
    dho:url "https://suttacentral.net/sn46.50/en/sujato#sn46.50:1.2"^^xsd:anyURI .

dho:p-sn46.50-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.50 ;
    dho:segment "sn46.50:1.6" ;
    dho:textPi "Evaṁ kho, bhikkhave, bhikkhu kalyāṇamitto satta bojjhaṅge bhāveti, satta bojjhaṅge bahulīkarotī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.50/en/sujato#sn46.50:1.6"^^xsd:anyURI .

dho:p-sn46.51-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:1.4" ;
    dho:textEn "And what fuels the arising of sensual desire, or, when it has arisen, makes it increase and grow?"@en ;
    dho:textPi "Ko ca, bhikkhave, āhāro anuppannassa vā kāmacchandassa uppādāya, uppannassa vā kāmacchandassa bhiyyobhāvāya vepullāya?"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:1.4"^^xsd:anyURI .

dho:p-sn46.51-1.5 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:1.5" ;
    dho:textEn "There is the feature of beauty."@en ;
    dho:textPi "Atthi, bhikkhave, subhanimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:1.5"^^xsd:anyURI .

dho:p-sn46.51-1.6 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:1.6" ;
    dho:textEn "Frequent irrational application of mind to that"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:1.6"^^xsd:anyURI .

dho:p-sn46.51-1.7 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:1.7" ;
    dho:textEn "fuels the arising of sensual desire, or, when it has arisen, makes it increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā kāmacchandassa uppādāya, uppannassa vā kāmacchandassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:1.7"^^xsd:anyURI .

dho:p-sn46.51-10.1 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:10.1" ;
    dho:textEn "And what fuels the arising of the awakening factor of tranquility, or, when it has arisen, fully develops it?"@en ;
    dho:textPi "Ko ca, bhikkhave, āhāro anuppannassa vā passaddhisambojjhaṅgassa uppādāya, uppannassa vā passaddhisambojjhaṅgassa bhāvanāya pāripūriyā?"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:10.1"^^xsd:anyURI .

dho:p-sn46.51-10.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:10.2" ;
    dho:textEn "There is tranquility of the body and of the mind."@en ;
    dho:textPi "Atthi, bhikkhave, kāyappassaddhi cittappassaddhi."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:10.2"^^xsd:anyURI .

dho:p-sn46.51-10.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:10.3" ;
    dho:textEn "Frequent rational application of mind to that"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:10.3"^^xsd:anyURI .

dho:p-sn46.51-10.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:10.4" ;
    dho:textEn "fuels the arising of the awakening factor of tranquility, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā passaddhisambojjhaṅgassa uppādāya, uppannassa vā passaddhisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:10.4"^^xsd:anyURI .

dho:p-sn46.51-11.1 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:11.1" ;
    dho:textEn "And what fuels the arising of the awakening factor of immersion, or, when it has arisen, fully develops it?"@en ;
    dho:textPi "Ko ca, bhikkhave, āhāro anuppannassa vā samādhisambojjhaṅgassa uppādāya, uppannassa vā samādhisambojjhaṅgassa bhāvanāya pāripūriyā?"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:11.1"^^xsd:anyURI .

dho:p-sn46.51-11.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:11.2" ;
    dho:textEn "There are things that are the basis of serenity and freedom from distraction."@en ;
    dho:textPi "Atthi, bhikkhave, samathanimittaṁ abyagganimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:11.2"^^xsd:anyURI .

dho:p-sn46.51-11.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:11.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:11.3"^^xsd:anyURI .

dho:p-sn46.51-11.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:11.4" ;
    dho:textEn "fuels the arising of the awakening factor of immersion, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā samādhisambojjhaṅgassa uppādāya, uppannassa vā samādhisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:11.4"^^xsd:anyURI .

dho:p-sn46.51-12.1 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:12.1" ;
    dho:textEn "And what fuels the arising of the awakening factor of equanimity, or, when it has arisen, fully develops it?"@en ;
    dho:textPi "Ko ca, bhikkhave, āhāro anuppannassa vā upekkhāsambojjhaṅgassa uppādāya, uppannassa vā upekkhāsambojjhaṅgassa bhāvanāya pāripūriyā?"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:12.1"^^xsd:anyURI .

dho:p-sn46.51-12.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:12.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of equanimity."@en ;
    dho:textPi "Atthi, bhikkhave, upekkhāsambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:12.2"^^xsd:anyURI .

dho:p-sn46.51-12.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:12.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:12.3"^^xsd:anyURI .

dho:p-sn46.51-12.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:12.4" ;
    dho:textEn "fuels the arising of the awakening factor of equanimity, or, when it has arisen, fully develops it."@en ;
    dho:textPi "ayamāhāro anuppannassa vā upekkhāsambojjhaṅgassa uppādāya, uppannassa vā upekkhāsambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:12.4"^^xsd:anyURI .

dho:p-sn46.51-13.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:13.2" ;
    dho:textEn "There is the feature of ugliness."@en ;
    dho:textPi "Atthi, bhikkhave, asubhanimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:13.2"^^xsd:anyURI .

dho:p-sn46.51-13.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:13.3" ;
    dho:textEn "Frequent rational application of mind to that"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:13.3"^^xsd:anyURI .

dho:p-sn46.51-13.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:13.4" ;
    dho:textEn "starves the arising of sensual desire, or, when it has arisen, starves its increase and growth."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā kāmacchandassa uppādāya, uppannassa vā kāmacchandassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:13.4"^^xsd:anyURI .

dho:p-sn46.51-14.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:14.2" ;
    dho:textEn "There is the heart’s release by love."@en ;
    dho:textPi "Atthi, bhikkhave, mettācetovimutti."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:14.2"^^xsd:anyURI .

dho:p-sn46.51-14.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:14.3" ;
    dho:textEn "Frequent rational application of mind to that"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:14.3"^^xsd:anyURI .

dho:p-sn46.51-14.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:14.4" ;
    dho:textEn "starves the arising of ill will, or, when it has arisen, starves its increase and growth."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā byāpādassa uppādāya, uppannassa vā byāpādassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:14.4"^^xsd:anyURI .

dho:p-sn46.51-15.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:15.2" ;
    dho:textEn "There are the elements of initiative, persistence, and exertion."@en ;
    dho:textPi "Atthi, bhikkhave, ārambhadhātu nikkamadhātu parakkamadhātu."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:15.2"^^xsd:anyURI .

dho:p-sn46.51-15.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:15.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:15.3"^^xsd:anyURI .

dho:p-sn46.51-15.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:15.4" ;
    dho:textEn "starves the arising of dullness and drowsiness, or, when they have arisen, starves their increase and growth."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā thinamiddhassa uppādāya, uppannassa vā thinamiddhassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:15.4"^^xsd:anyURI .

dho:p-sn46.51-16.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:16.2" ;
    dho:textEn "There is the settled mind."@en ;
    dho:textPi "Atthi, bhikkhave, cetaso vūpasamo."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:16.2"^^xsd:anyURI .

dho:p-sn46.51-16.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:16.3" ;
    dho:textEn "Frequent rational application of mind to that"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:16.3"^^xsd:anyURI .

dho:p-sn46.51-16.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:16.4" ;
    dho:textEn "starves the arising of restlessness and remorse, or, when they have arisen, starves their increase and growth."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā uddhaccakukkuccassa uppādāya, uppannassa vā uddhaccakukkuccassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:16.4"^^xsd:anyURI .

dho:p-sn46.51-17.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:17.2" ;
    dho:textEn "There are qualities that are skillful and unskillful, blameworthy and blameless, inferior and superior, and those with a portion of dark or bright."@en ;
    dho:textPi "Atthi, bhikkhave, kusalākusalā dhammā sāvajjānavajjā dhammā hīnapaṇītā dhammā kaṇhasukkasappaṭibhāgā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:17.2"^^xsd:anyURI .

dho:p-sn46.51-17.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:17.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:17.3"^^xsd:anyURI .

dho:p-sn46.51-17.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:17.4" ;
    dho:textEn "starves the arising of doubt, or, when it has arisen, starves its increase and growth."@en ;
    dho:textPi "ayamanāhāro anuppannāya vā vicikicchāya uppādāya, uppannāya vā vicikicchāya bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:17.4"^^xsd:anyURI .

dho:p-sn46.51-18.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:18.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of mindfulness."@en ;
    dho:textPi "Atthi, bhikkhave, satisambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:18.2"^^xsd:anyURI .

dho:p-sn46.51-18.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:18.3" ;
    dho:textEn "Not frequently applying the mind to that"@en ;
    dho:textPi "Tattha amanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:18.3"^^xsd:anyURI .

dho:p-sn46.51-18.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:18.4" ;
    dho:textEn "starves the arising of the awakening factor of mindfulness, or, when it has arisen, starves its full development."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā satisambojjhaṅgassa uppādāya, uppannassa vā satisambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:18.4"^^xsd:anyURI .

dho:p-sn46.51-19.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:19.2" ;
    dho:textEn "There are qualities that are skillful and unskillful, blameworthy and blameless, inferior and superior, and those with a portion of dark or bright."@en ;
    dho:textPi "Atthi, bhikkhave, kusalākusalā dhammā sāvajjānavajjā dhammā hīnapaṇītā dhammā kaṇhasukkasappaṭibhāgā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:19.2"^^xsd:anyURI .

dho:p-sn46.51-19.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:19.3" ;
    dho:textEn "Not frequently applying the mind to that"@en ;
    dho:textPi "Tattha amanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:19.3"^^xsd:anyURI .

dho:p-sn46.51-19.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:19.4" ;
    dho:textEn "starves the arising of the awakening factor of investigation of principles, or, when it has arisen, starves its full development."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā dhammavicayasambojjhaṅgassa uppādāya, uppannassa vā dhammavicayasambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:19.4"^^xsd:anyURI .

dho:p-sn46.51-2.1 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:2.1" ;
    dho:textEn "And what fuels the arising of ill will, or, when it has arisen, makes it increase and grow?"@en ;
    dho:textPi "Ko ca, bhikkhave, āhāro anuppannassa vā byāpādassa uppādāya, uppannassa vā byāpādassa bhiyyobhāvāya vepullāya?"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:2.1"^^xsd:anyURI .

dho:p-sn46.51-2.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:2.2" ;
    dho:textEn "There is the feature of aversion."@en ;
    dho:textPi "Atthi, bhikkhave, paṭighanimittaṁ."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:2.2"^^xsd:anyURI .

dho:p-sn46.51-2.3 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:2.3" ;
    dho:textEn "Frequent irrational application of mind to that"@en ;
    dho:textPi "Tattha ayonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:2.3"^^xsd:anyURI .

dho:p-sn46.51-2.4 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:2.4" ;
    dho:textEn "fuels the arising of ill will, or, when it has arisen, makes it increase and grow."@en ;
    dho:textPi "ayamāhāro anuppannassa vā byāpādassa uppādāya, uppannassa vā byāpādassa bhiyyobhāvāya vepullāya."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:2.4"^^xsd:anyURI .

dho:p-sn46.51-20.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:20.2" ;
    dho:textEn "There are the elements of initiative, persistence, and exertion."@en ;
    dho:textPi "Atthi, bhikkhave, ārambhadhātu nikkamadhātu parakkamadhātu."@pi ;
