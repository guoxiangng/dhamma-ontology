    dho:inText dho:t-sn46.57 ;
    dho:segment "sn46.57:6.3" ;
    dho:textPi "Idha, bhikkhave, bhikkhu aṭṭhikasaññāsahagataṁ satisambojjhaṅgaṁ bhāveti …pe…"@pi ;
    dho:url "https://suttacentral.net/sn46.57/en/sujato#sn46.57:6.3"^^xsd:anyURI .

dho:p-sn46.57-6.5 a dho:Passage ;
