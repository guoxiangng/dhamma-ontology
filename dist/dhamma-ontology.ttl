        dho:p-sn46.76-1.4,
        dho:p-sn46.76-2.6,
        dho:p-sn46.76-3.4 ;
    dho:condition dho:Virāga ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:BasisOf ;
    dho:wording "on seclusion, fading away, and cessation" .

dho:c-19 a dho:Condition ;
    dho:citedBy dho:p-sn46.1-1.12,
        dho:p-sn46.1-1.6,
        dho:p-sn46.11-2.3,
        dho:p-sn46.12-2.3,
        dho:p-sn46.13-2.3,
        dho:p-sn46.130-1.8,
        dho:p-sn46.21-2.5,
