dho:DhammaMindObject a dho:Concept ;
    skos:definition "What the mind knows, as the sixth sense field alongside sights, sounds, smells, tastes and touches (dhammāyatana)."@en ;
    skos:prefLabel "a dhamma (an object of the mind, an idea)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaPhenomenon a dho:Concept ;
    skos:definition "Any thing at all, as in 'all things are not-self' (sabbe dhammā anattā)."@en ;
    skos:prefLabel "a dhamma (any phenomenon, any thing)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaQuality a dho:Concept ;
    skos:definition "A quality of mind, e.g. 'qualities that are skillful and unskillful' (kusalākusalā dhammā)."@en ;
    skos:prefLabel "a dhamma (a mental quality)"@en,
        "dhamma"@pi,
        "法"@zh .

dho:DhammaTeaching a dho:Concept ;
    skos:definition "The teaching the Buddha explained: 'the teaching is well explained by the Buddha' (svākkhāto bhagavatā dhammo)."@en ;
    skos:prefLabel "the Dhamma (the Buddha's teaching)"@en,
        "dhamma"@pi,
        "法"@zh .

