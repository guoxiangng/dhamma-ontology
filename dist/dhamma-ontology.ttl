dho:t-sn46.38 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.38 Anīvaraṇasutta — Without Obstacles"@en ;
    dho:coverage dho:FullyEncoded ;
    dho:encodes "Both lists (2.1, 2.2; 3.1, 3.2), and the teaching: when a noble disciple pays attention, applies the mind, concentrates wholeheartedly and actively listens to the teaching, the five hindrances are absent and the seven awakening factors are fully developed (1.1, 3.4)." ;
    dho:layer dho:SuttaLayer ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.38/en/sujato"^^xsd:anyURI .

dho:t-sn46.42 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.42 Cakkavattisutta — A Wheel-Turning Monarch"@en ;
    dho:coverage dho:FullyEncoded ;
    dho:encodes "The list (2.1, 2.3); when a Realized One appears, the seven treasures of the awakening factors appear (2.1, 2.4); the comparison with a Wheel-Turning Monarch's seven treasures, as a simile (1.1-1.4; D23)." ;
    dho:layer dho:SuttaLayer ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-16"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.42/en/sujato"^^xsd:anyURI .

