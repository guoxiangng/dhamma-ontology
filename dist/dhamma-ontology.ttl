    skos:altLabel "applied thought"@en,
        "directed thought"@en,
        "覺"@zh ;
    skos:prefLabel "placing the mind"@en,
        "vitakka"@pi,
        "尋"@zh .

dho:Rejoicing a dho:Practice ;
    skos:altLabel "sympathetic joy"@en ;
    skos:hiddenLabel "brahmavihara"@en,
        "four immeasurables"@en,
        "喜"@zh,
        "喜心"@zh,
        "四梵住"@zh,
        "四無量心"@zh,
        "隨喜"@zh ;
    skos:prefLabel "rejoicing"@en,
        "muditā"@pi,
        "喜無量"@zh ;
    dho:editorialRelated dho:HeartsReleaseByRejoicing .

dho:RequiredFor a dho:ConditionRelation ;
    rdfs:label "is required for"@en ;
    rdfs:comment "'not apart from' (nāññatra): the conditioned don't arise apart from the condition. A necessary condition, not a sufficient one (SN 46.9, 46.10; D23)."@en .

dho:Restlessness a dho:MentalQuality ;
    skos:prefLabel "restlessness"@en,
        "uddhacca"@pi,
        "掉舉"@zh .

dho:RootOf a dho:ConditionRelation ;
    rdfs:label "is the root of"@en ;
    rdfs:comment "'rooted in and meet at' (mūlaka, samosaraṇa)."@en .

dho:Sambodhi a dho:Concept ;
    skos:prefLabel "awakening"@en,
        "sambodhi"@pi ;
    dho:editorialRelated dho:Bodhi .

dho:SanctuaryFromYoke a dho:Concept ;
    skos:prefLabel "great sanctuary from the yoke"@en,
        "yogakkhema"@pi .

