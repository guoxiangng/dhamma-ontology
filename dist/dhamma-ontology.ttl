    dho:citedBy dho:p-sn46.2-5.2,
        dho:p-sn46.2-5.3,
        dho:p-sn46.51-4.2,
        dho:p-sn46.51-4.3 ;
    dho:fuels dho:RestlessnessRemorse ;
    dho:object dho:o-unsettled-mind .

dho:n-05 a dho:Nutriment ;
    dho:attention dho:IrrationalAttention ;
    dho:citedBy dho:p-sn46.2-6.2,
        dho:p-sn46.2-6.3,
        dho:p-sn46.51-5.2,
        dho:p-sn46.51-5.3 ;
    dho:fuels dho:Doubt ;
    dho:object dho:o-grounds-doubt .

dho:n-06 a dho:Nutriment ;
    dho:attention dho:RationalAttention ;
    dho:citedBy dho:p-sn46.2-9.2,
        dho:p-sn46.2-9.3,
        dho:p-sn46.51-6.2,
        dho:p-sn46.51-6.3 ;
    dho:fuels dho:Mindfulness ;
    dho:object dho:o-grounds-mindfulness .

dho:n-07 a dho:Nutriment ;
    dho:attention dho:RationalAttention ;
    dho:citedBy dho:p-sn46.2-10.2,
        dho:p-sn46.2-10.3,
        dho:p-sn46.51-7.2,
        dho:p-sn46.51-7.3 ;
    dho:fuels dho:Investigation ;
    dho:object dho:o-qualities .

dho:n-08 a dho:Nutriment ;
    dho:attention dho:RationalAttention ;
    dho:citedBy dho:p-sn46.2-11.2,
        dho:p-sn46.2-11.3,
        dho:p-sn46.51-8.2,
        dho:p-sn46.51-8.3 ;
    dho:fuels dho:Energy ;
    dho:object dho:o-energy-elements .

dho:n-09 a dho:Nutriment ;
    dho:attention dho:RationalAttention ;
    dho:citedBy dho:p-sn46.2-12.2,
        dho:p-sn46.2-12.3,
        dho:p-sn46.51-9.2,
        dho:p-sn46.51-9.3 ;
    dho:fuels dho:Rapture ;
    dho:object dho:o-grounds-rapture .

dho:n-10 a dho:Nutriment ;
    dho:attention dho:RationalAttention ;
    dho:citedBy dho:p-sn46.2-13.2,
        dho:p-sn46.2-13.3,
        dho:p-sn46.51-10.2,
