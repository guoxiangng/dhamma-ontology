    rdfs:comment "uppajjati / bhāvanāpāripūriṁ gacchati (D19)."@en .

dho:BloatedPerception a dho:Practice ;
    skos:prefLabel "the perception of a bloated corpse"@en,
        "uddhumātakasaññā"@pi .

dho:BodilyGoodConduct a dho:Concept ;
    skos:prefLabel "good conduct by way of body"@en,
        "kāyasucarita"@pi .

dho:CessationOfCraving a dho:Concept ;
    skos:prefLabel "the cessation of craving"@en,
        "taṇhānirodha"@pi .

dho:Conceit a dho:MentalQuality ;
    skos:prefLabel "conceit"@en,
        "māna"@pi,
        "慢"@zh .

dho:CrushingMarasArmy a dho:Concept ;
    skos:prefLabel "crushing Māra’s army"@en,
        "mārasenappamaddana"@pi .

dho:DeathPerception a dho:Practice ;
    skos:prefLabel "the perception of death"@en,
        "maraṇasaññā"@pi .

dho:Deathless a dho:Concept ;
    skos:altLabel "the deathless"@en ;
    skos:prefLabel "freedom from death"@en,
        "amata"@pi .

dho:DesireForFormRebirth a dho:MentalQuality ;
    skos:prefLabel "desire for rebirth in the realm of luminous form"@en,
        "rūparāga"@pi,
        "色貪"@zh .

