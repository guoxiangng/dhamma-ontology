dho:AppearanceOfRealizedOne a dho:Concept ;
    skos:altLabel "the appearance of a Buddha"@en ;
    skos:note "'A Realized One, a perfected one, a fully awakened Buddha' (tathāgata arahant sammāsambuddha), SN 46.9 and 46.42."@en ;
    skos:prefLabel "the appearance of a Realized One"@en,
        "tathāgatassa pātubhāva"@pi,
        "如來出世"@zh .

dho:Bliss a dho:MentalQuality ;
    skos:altLabel "happiness"@en,
        "pleasure"@en ;
    skos:prefLabel "bliss"@en,
        "sukha"@pi,
        "樂"@zh .

dho:Bodhi a dho:Concept ;
    skos:prefLabel "awakening"@en,
        "bodhi"@pi .

dho:CauseOf a dho:ConditionRelation ;
    rdfs:label "is a cause and reason for"@en ;
    rdfs:comment "'a cause and reason for' (hetu, paccaya), SN 46.56 (D16)."@en .

dho:Cessation a dho:Concept ;
    skos:prefLabel "cessation"@en,
        "nirodha"@pi,
        "滅"@zh .

dho:Compassion a dho:Practice ;
    skos:hiddenLabel "brahmavihara"@en,
        "four immeasurables"@en,
        "四梵住"@zh,
        "四無量心"@zh,
        "悲"@zh,
        "悲心"@zh,
        "慈悲"@zh ;
    skos:prefLabel "compassion"@en,
        "karuṇā"@pi,
        "悲無量"@zh ;
    dho:editorialRelated dho:HeartsReleaseByCompassion .

dho:Diligence a dho:Concept ;
    skos:altLabel "heedfulness"@en ;
    skos:prefLabel "diligence"@en,
        "appamāda"@pi,
        "不放逸"@zh .

dho:Enlightenment a dho:Concept ;
    skos:prefLabel "enlightenment in this very life"@en,
        "aññā"@pi .

dho:EquanimityImmeasurable a dho:Practice ;
    skos:hiddenLabel "brahmavihara"@en,
        "four immeasurables"@en,
        "四梵住"@zh,
        "四無量心"@zh,
        "捨"@zh,
        "捨心"@zh ;
    skos:prefLabel "equanimity"@en,
        "upekkhā"@pi,
        "捨無量"@zh ;
    dho:editorialRelated dho:Equanimity,
        dho:HeartsReleaseByEquanimity .

dho:FirstJhanaFactors a dho:NumberedList ;
    skos:prefLabel "the five factors of the first absorption"@en,
        "paṭhamajjhānassa pañcaṅgāni"@pi,
        "初禪五支"@zh ;
    dho:citedBy dho:p-mn43-19.2,
        dho:p-mn43-19.3 ;
    dho:expectedCount 5 ;
    dho:hasMember dho:Bliss,
        dho:KeepingConnected,
        dho:PlacingTheMind,
        dho:Rapture,
        dho:Unification .

dho:ForerunnerOf a dho:ConditionRelation ;
    rdfs:label "is the forerunner of"@en ;
    rdfs:comment "'the forerunner and harbinger of' (pubbaṅgama, pubbanimitta)."@en .

dho:FourMindfulnessMeditations a dho:NumberedList ;
    skos:altLabel "four establishments of mindfulness"@en,
        "four foundations of mindfulness"@en,
        "satipaṭṭhāna"@pi ;
    skos:prefLabel "the four kinds of mindfulness meditation"@en,
        "cattāro satipaṭṭhānā"@pi,
        "四念處"@zh ;
    dho:citedBy dho:p-sn46.6-2.4,
