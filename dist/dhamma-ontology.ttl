dho:p-sn46.20-1.1 a dho:Passage ;
    dho:inText dho:t-sn46.20 ;
    dho:segment "sn46.20:1.1" ;
    dho:textEn "“Mendicants, the seven awakening factors, when developed and cultivated, lead solely to disillusionment, dispassion, cessation, peace, insight, awakening, and extinguishment."@en ;
    dho:textPi "“Sattime, bhikkhave, bojjhaṅgā bhāvitā bahulīkatā ekantanibbidāya virāgāya nirodhāya upasamāya abhiññāya sambodhāya nibbānāya saṁvattanti."@pi ;
    dho:url "https://suttacentral.net/sn46.20/en/sujato#sn46.20:1.1"^^xsd:anyURI .

dho:p-sn46.20-1.4 a dho:Passage ;
    dho:inText dho:t-sn46.20 ;
    dho:segment "sn46.20:1.4" ;
    dho:textEn "These seven awakening factors, when developed and cultivated, lead solely to disillusionment, dispassion, cessation, peace, insight, awakening, and extinguishment.”"@en ;
    dho:textPi "ime kho, bhikkhave, satta bojjhaṅgā bhāvitā bahulīkatā ekantanibbidāya virāgāya nirodhāya upasamāya abhiññāya sambodhāya nibbānāya saṁvattantī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.20/en/sujato#sn46.20:1.4"^^xsd:anyURI .

