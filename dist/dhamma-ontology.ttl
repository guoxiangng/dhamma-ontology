    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:9.3" ;
    dho:textEn "Frequent rational application of mind to them"@en ;
    dho:textPi "Tattha yonisomanasikārabahulīkāro—"@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:9.3"^^xsd:anyURI .

dho:p-sn46.53-15.4 a dho:Passage ;
    dho:inText dho:t-sn46.53 ;
    dho:segment "sn46.53:15.4" ;
    dho:textEn "But mindfulness is always useful, I say.”"@en ;
    dho:textPi "Satiñca khvāhaṁ, bhikkhave, sabbatthikaṁ vadāmī”ti."@pi ;
    dho:url "https://suttacentral.net/sn46.53/en/sujato#sn46.53:15.4"^^xsd:anyURI .

