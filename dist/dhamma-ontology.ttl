dho:SensualLust a dho:Concept ;
    skos:note "SN 46.55 opens its five with kāmarāga, not the hindrance's usual name kāmacchanda; the other four are the hindrances' names. Sujato renders both words 'sensual desire'. Kept as its own concept, editor-linked to sensual desire, because the text uses a different word (D23, as for the fetter uddhacca, D13)."@en ;
    skos:prefLabel "sensual lust"@en,
        "kāmarāga"@pi ;
    dho:editorialRelated dho:SensualDesire .

dho:SevenFruits a dho:NumberedList ;
    skos:note "The text's order (9.3-9.9): enlightenment early in this very life; at the time of death; extinguished between one life and the next; upon landing; without extra effort; with extra effort; heading upstream to the Akaniṭṭha realm. The members are a set here; the order is in this note only."@en ;
    skos:prefLabel "the seven fruits and benefits of the awakening factors"@en,
        "satta phalā sattānisaṁsā"@pi ;
    dho:citedBy dho:p-sn46.3-9.1,
        dho:p-sn46.3-9.10,
        dho:p-sn46.3-9.2 ;
    dho:expectedCount 7 ;
    dho:hasMember dho:EarlyEnlightenment,
        dho:EnlightenmentAtDeath,
        dho:ExtinguishedBetweenLives,
        dho:ExtinguishedUponLanding,
        dho:ExtinguishedWithEffort,
        dho:ExtinguishedWithoutEffort,
        dho:HeadingUpstream .

