dho:t-mn43 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "MN 43 Mahāvedallasutta — The Great Elaboration"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Only the first absorption: its five factors (19.2-19.3), and that it gives up the five hindrances and possesses those five factors (20.2-20.4)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "Most of the dialogue: wisdom and consciousness (2-6), feeling and perception (7-11), the goal of wisdom and conditions for right view (12-14), states of existence (15-17), what the first absorption is (18), the five faculties (21-22), vital forces and death vs cessation (23-25), and the releases of the heart (26-37)." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-13"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/mn43/en/sujato"^^xsd:anyURI .

