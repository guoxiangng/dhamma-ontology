    dho:segment "sn46.51:20.4" ;
    dho:textEn "starves the arising of the awakening factor of energy, or, when it has arisen, starves its full development."@en ;
    dho:textPi "ayamanāhāro anuppannassa vā vīriyasambojjhaṅgassa uppādāya, uppannassa vā vīriyasambojjhaṅgassa bhāvanāya pāripūriyā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:20.4"^^xsd:anyURI .

dho:p-sn46.51-21.2 a dho:Passage ;
    dho:inText dho:t-sn46.51 ;
    dho:segment "sn46.51:21.2" ;
    dho:textEn "There are things that are grounds for the awakening factor of rapture."@en ;
    dho:textPi "Atthi, bhikkhave, pītisambojjhaṅgaṭṭhānīyā dhammā."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:21.2"^^xsd:anyURI .

