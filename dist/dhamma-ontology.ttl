    rdfs:subClassOf dho:MentalQuality ;
    owl:disjointWith dho:AwakeningFactor,
        dho:JhanaFactor ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:hasValue dho:FiveHindrances ;
            owl:onProperty dho:memberOf ] .

dho:Insight a dho:Concept ;
    skos:altLabel "direct knowledge"@en ;
    skos:prefLabel "insight"@en,
        "abhiññā"@pi .

dho:Inspiration a dho:Concept ;
    skos:prefLabel "great inspiration"@en,
        "saṁvega"@pi .

dho:KeepingConnected a dho:MentalQuality ;
    skos:altLabel "evaluation"@en,
        "sustained thought"@en,
        "觀"@zh ;
    skos:prefLabel "keeping it connected"@en,
        "vicāra"@pi,
        "伺"@zh .

dho:ListeningToTeaching a dho:Concept ;
    skos:prefLabel "actively listening to the teaching"@en,
        "ohitasoto dhammaṁ suṇāti"@pi .

dho:Love a dho:Practice ;
    skos:altLabel "loving-kindness"@en ;
    skos:hiddenLabel "brahmavihara"@en,
