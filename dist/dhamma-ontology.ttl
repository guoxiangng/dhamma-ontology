dho:WhenThen a dho:ConditionRelation ;
    rdfs:label "when present, then"@en ;
    rdfs:comment "'when you …, X …'; the result says what happens to the conditioned."@en .

dho:t-sn46.56 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.56 Abhayasutta — With Prince Abhaya"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "The hindrances are a cause and reason for not knowing and not seeing, when the heart is overcome by them (2.3-3.5); the awakening factors are a cause and reason for knowing and seeing (5.3-6.4); the stock formula (5.3, 6.2)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "The framing: Prince Abhaya reports Pūraṇa Kassapa's view that knowing and not knowing have no cause (1.4-1.9). (The Buddha's reply, 1.10-1.13, that both have causes and reasons, is encoded; corrected 2026-11-15.) The naming 'these are called the hindrances / awakening factors' (4.2, 7.2). Prince Abhaya's responses, including 'overcome by even a single hindrance you wouldn't truly know or see' and 'endowed with even a single awakening factor you would' (4.3-4.5, 7.3-7.6): said by the interlocutor, not taught, so not encoded (D17)." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.56/en/sujato"^^xsd:anyURI .

dho:t-sn46.76 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.76 Nirodhasutta — Cessation"@en ;
    dho:coverage dho:FullyEncoded ;
    dho:encodes "The perception of cessation is very fruitful and beneficial (1.1, 1.5); each awakening factor is developed accompanied by it (1.3-1.4, 2.5-2.6, 3.3-3.4), with the stock formula; one of two results, enlightenment in this very life or non-return; great benefit, great sanctuary from the yoke, great inspiration and great ease." ;
    dho:layer dho:SuttaLayer ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.76/en/sujato"^^xsd:anyURI .

dho:Division a owl:Class ;
    rdfs:label "Division"@en ;
    rdfs:comment "A sutta's statement that one quality is twofold, naming the two."@en .

