        dho:p-sn46.6-7.3,
        dho:p-sn46.6-7.4,
        dho:p-sn46.6-7.5 ;
    dho:expectedCount 4 ;
    dho:hasMember dho:ObservingBody,
        dho:ObservingFeelings,
        dho:ObservingMind,
        dho:ObservingPrinciples .

dho:FruitOfKnowledgeAndFreedom a dho:Concept ;
    skos:prefLabel "the realization of the fruit of knowledge and freedom"@en,
        "vijjāvimuttiphalasacchikiriyā"@pi .

dho:GivesRiseTo a dho:ConditionRelation ;
    rdfs:label "gives rise to"@en .

dho:GreatBenefit a dho:Concept ;
    skos:prefLabel "great benefit"@en,
        "attha"@pi .

dho:HeartsReleaseByCompassion a dho:Concept ;
    skos:prefLabel "the heart's release by compassion"@en,
        "karuṇācetovimutti"@pi,
        "悲心解脫"@zh .

dho:HeartsReleaseByEquanimity a dho:Concept ;
