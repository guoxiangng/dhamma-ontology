        dho:p-sn46.11-1.3 ;
    dho:condition dho:Ethics ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:BasisOf ;
    dho:wording "depending on and grounded on ethics" .

dho:o-grounds-equanimity a dho:AttentionObject ;
    skos:prefLabel "things that are grounds for the awakening factor of equanimity"@en,
        "upekkhāsambojjhaṅgaṭṭhānīyā dhammā"@pi .

dho:o-grounds-mindfulness a dho:AttentionObject ;
