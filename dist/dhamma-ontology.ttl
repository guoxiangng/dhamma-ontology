    skos:prefLabel "the three kinds of good conduct"@en,
        "tīṇi sucaritāni"@pi ;
    dho:citedBy dho:p-sn46.6-2.6,
        dho:p-sn46.6-6.2 ;
    dho:expectedCount 3 ;
    dho:hasMember dho:BodilyGoodConduct,
        dho:MentalGoodConduct,
        dho:VerbalGoodConduct .

dho:Virāga a dho:Concept ;
