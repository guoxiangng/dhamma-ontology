    dho:textPi "Atthi, bhikkhave, ārambhadhātu nikkamadhātu parakkamadhātu."@pi ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato#sn46.51:8.2"^^xsd:anyURI .

