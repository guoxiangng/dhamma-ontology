        "慈悲"@zh ;
    skos:prefLabel "love"@en,
        "mettā"@pi,
        "慈無量"@zh ;
    dho:editorialRelated dho:o-metta .

dho:NamedParts a dho:DivisionBasis ;
    rdfs:label "the two qualities its name joins"@en ;
    rdfs:comment "A compound name split into its two words: thina / middha, uddhacca / kukkucca."@en .

dho:NonReturn a dho:Concept ;
    skos:prefLabel "non-return"@en,
        "anāgāmitā"@pi .

dho:PhysicalMental a dho:DivisionBasis ;
    rdfs:label "physical and mental"@en ;
    rdfs:comment "kāyika / cetasika; kāya / citta."@en .

