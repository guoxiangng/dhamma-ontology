    rdfs:comment "One of the canon's numbered lists (the five hindrances, the seven awakening factors, ...)."@en ;
    rdfs:subClassOf skos:Collection .

dho:t-sn46.24 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.24 Ayonisomanasikārasutta — Irrational Application of Mind"@en ;
    dho:coverage dho:FullyEncoded ;
    dho:encodes "Irrational application of mind: the hindrances arise and grow, the awakening factors don't arise or cease (1.1-1.6). Rational application of mind: the hindrances don't arise or are given up, the awakening factors arise and are fully developed (2.1-3.1)." ;
    dho:layer dho:SuttaLayer ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.24/en/sujato"^^xsd:anyURI .

dho:t-sn46.53 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.53 Aggisutta — Fire"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "The timing advice: which awakening factors it is the right or wrong time to develop when the mind is sluggish (4.1, 7.1) or restless (10.1, 13.1), the reason given for each, and 'mindfulness is always useful' (15.4)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "The setting and the challenge from wanderers of other religions (1.1-3.1); the four fire similes (5, 8, 11, 14) that illustrate the advice; the repeated statements after each simile (6, 9, 12, 15.1-15.3)." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-13"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.53/en/sujato"^^xsd:anyURI .

dho:FullyEncoded a dho:CoverageStatus ;
    rdfs:label "fully encoded"@en ;
    rdfs:comment "Every teaching claim in the text is modelled."@en .

dho:t-sn46.37 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.37 Āvaraṇanīvaraṇasutta — Obstacles"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Both lists (1.1, 1.3-1.7; 2.1, 2.3); the hindrances weaken wisdom (1.1, 1.8); developing the awakening factors leads to the realization of the fruit of knowledge and freedom (2.1, 2.4)." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "That the hindrances are obstacles and corruptions of the heart, and the awakening factors are not (1.1, 1.8, 2.1, 2.4). Needs a pattern for what a quality is or is not." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.37/en/sujato"^^xsd:anyURI .

dho:LeadsTo a dho:Effect ;
    rdfs:label "leads to"@en .

dho:AttentionObject a owl:Class ;
    rdfs:label "Object of attention"@en ;
    rdfs:comment "What the mind is applied to, e.g. 'the feature of beauty' (subhanimitta)."@en ;
    rdfs:subClassOf dho:Concept .

dho:TimingAdvice a owl:Class ;
    rdfs:label "Timing advice"@en ;
    rdfs:comment "One statement from SN 46.53: when the mind is in STATE, it is the right/wrong time to develop FACTOR."@en .

dho:RationalAttention a dho:AttentionMode ;
    rdfs:label "rational application of mind"@en,
        "yoniso manasikāra"@pi,
        "如理作意"@zh .

dho:PartlyEncoded a dho:CoverageStatus ;
    rdfs:label "partly encoded"@en ;
    rdfs:comment "Some sections are modelled; dho:leftOut says what is not."@en .

dho:MentalQuality a owl:Class ;
    rdfs:label "Mental quality"@en ;
    rdfs:comment "A quality of mind that can arise, grow, or be abandoned."@en ;
    rdfs:subClassOf dho:Concept .

dho:Outcome a owl:Class ;
    rdfs:label "Outcome"@en ;
    rdfs:comment "A sutta's statement that something leads to, or works against, something else."@en .

dho:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A sutta's statement that one thing conditions another."@en .

dho:t-sn46.2 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.2 Kāyasutta — The Body"@en ;
    dho:coverage dho:PartlyEncoded ;
    dho:encodes "Its 12 statements of what fuels the five hindrances and seven awakening factors (2-6, 9-15). They match SN 46.51 sections 1-12 (identical English; Pali differs only in punctuation and one spelling variant), so they were added as a second citation on the same claims, not as new claims." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "The simile framing the teaching: as the body is sustained by food, so the hindrances and the awakening factors are sustained by fuel (1.2-1.3, 7, 8, 16). There is no pattern for similes yet." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-14"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.2/en/sujato"^^xsd:anyURI .

dho:Nutriment a owl:Class ;
    rdfs:label "Nutriment"@en,
        "āhāra"@pi,
        "食"@zh ;
    rdfs:comment "One statement from SN 46.51: an object, a mode of attention, and the quality it fuels or starves."@en .

dho:Concept a owl:Class ;
    rdfs:label "Concept"@en ;
    rdfs:comment "Anything the teachings talk about."@en ;
    rdfs:subClassOf skos:Concept .

