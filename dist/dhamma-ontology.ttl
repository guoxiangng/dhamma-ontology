dho:object a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "object"@en ;
    rdfs:domain dho:Nutriment ;
    rdfs:range dho:AttentionObject .

dho:op-01 a dho:Opposition ;
    dho:citationNote "Visuddhimagga IV.86 (citing the Peṭakopadesa)" ;
    dho:layer dho:CommentaryLayer ;
    dho:opponent dho:Unification ;
    dho:referencesText dho:t-vism ;
    dho:target dho:SensualDesire .

dho:op-02 a dho:Opposition ;
    dho:citationNote "Visuddhimagga IV.86 (citing the Peṭakopadesa)" ;
    dho:layer dho:CommentaryLayer ;
    dho:opponent dho:Rapture ;
    dho:referencesText dho:t-vism ;
    dho:target dho:IllWill .

dho:op-03 a dho:Opposition ;
    dho:citationNote "Visuddhimagga IV.86 (citing the Peṭakopadesa)" ;
    dho:layer dho:CommentaryLayer ;
    dho:opponent dho:PlacingTheMind ;
    dho:referencesText dho:t-vism ;
    dho:target dho:DullnessDrowsiness .

dho:op-04 a dho:Opposition ;
    dho:citationNote "Visuddhimagga IV.86 (citing the Peṭakopadesa)" ;
    dho:layer dho:CommentaryLayer ;
    dho:opponent dho:Bliss ;
    dho:referencesText dho:t-vism ;
    dho:target dho:RestlessnessRemorse .

dho:op-05 a dho:Opposition ;
    dho:citationNote "Visuddhimagga IV.86 (citing the Peṭakopadesa)" ;
    dho:layer dho:CommentaryLayer ;
    dho:opponent dho:KeepingConnected ;
    dho:referencesText dho:t-vism ;
    dho:target dho:Doubt .

dho:opponent a owl:ObjectProperty ;
    rdfs:label "opponent"@en ;
    rdfs:domain dho:Opposition ;
    rdfs:range dho:MentalQuality .

dho:p-mn10-36.2 a dho:Passage ;
    skos:note "Sense of dhamma here is contested; deliberately left unassigned in v0.1."@en ;
    dho:inText dho:t-mn10 ;
    dho:segment "mn10:36.2" ;
    dho:textEn "It’s when a mendicant meditates by observing an aspect of principles with respect to the five hindrances."@en ;
    dho:textPi "Idha, bhikkhave, bhikkhu dhammesu dhammānupassī viharati pañcasu nīvaraṇesu."@pi ;
    dho:translatorRendering "principles (Sujato)" ;
    dho:url "https://suttacentral.net/mn10/en/sujato#mn10:36.2"^^xsd:anyURI .

dho:possesses a owl:ObjectProperty ;
    rdfs:label "possesses"@en,
        "samannāgata"@pi ;
    rdfs:domain dho:Attainment ;
    rdfs:range dho:NumberedList .

dho:referencesText a owl:ObjectProperty ;
    rdfs:label "references text"@en ;
    rdfs:comment "For claims cited by reference only (dho:citationNote): the text referred to, which we do not hold."@en ;
    rdfs:range dho:Text .

dho:review a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "review"@en ;
    rdfs:domain dho:Text ;
    rdfs:range dho:ReviewStatus .

dho:segment a owl:DatatypeProperty ;
    rdfs:label "segment id"@en ;
    rdfs:domain dho:Passage .

dho:senseAssignedBy a owl:DatatypeProperty ;
    rdfs:label "sense assigned by"@en .

dho:starves a owl:ObjectProperty ;
    rdfs:label "starves"@en ;
    rdfs:comment "Prevents the quality arising, or its growth once arisen (anāhāra)."@en ;
    rdfs:domain dho:Nutriment ;
    rdfs:range dho:MentalQuality .

