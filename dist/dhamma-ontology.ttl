# dhamma-ontology: https://github.com/guoxiangng/dhamma-ontology
# Asserted: schema and data as written.
# Sutta text from SuttaCentral (CC0): English by Bhikkhu Sujato, Pali from the Mahāsaṅgīti edition.
# Personal learning project; modelling unreviewed. See COVERAGE.md and DECISIONS.md.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix dho: <https://guoxiangng.github.io/dhamma-ontology/ns#> .
@prefix ontolex: <http://www.w3.org/ns/lemon/ontolex#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://guoxiangng.github.io/dhamma-ontology/ns> a owl:Ontology ;
    rdfs:label "Dhamma ontology (v0.1)"@en ;
    rdfs:comment "A small, citation-first ontology of the hindrances, awakening factors and jhāna factors, built from the Pali suttas. Every doctrinal link points to the passage that states it."@en ;
    owl:versionInfo "0.1" .

dho:EditorLayer a dho:SourceLayer ;
    rdfs:label "Editor's judgment (this project)"@en .

dho:FirstJhana a dho:Attainment ;
    skos:altLabel "first jhāna"@en ;
    skos:prefLabel "first absorption"@en,
        "paṭhamaṁ jhānaṁ"@pi,
        "初禪"@zh ;
    dho:citedBy dho:p-mn43-20.2,
        dho:p-mn43-20.3,
        dho:p-mn43-20.4 ;
    dho:givesUp dho:FiveHindrances ;
    dho:possesses dho:FirstJhanaFactors .

dho:FiveCorruptionsOfMind a dho:NumberedList ;
    skos:note "In SN 46.33:2.3 the Pali names only sensual desire and abbreviates the rest (…pe…); the other four members are the conventional expansion, as the translation gives them."@en ;
    skos:prefLabel "the five corruptions of the mind"@en,
        "pañca cittassa upakkilesā"@pi ;
    dho:citedBy dho:p-sn46.33-2.1,
        dho:p-sn46.33-2.3,
        dho:p-sn46.33-2.4 ;
    dho:expectedCount 5 ;
    dho:hasMember dho:Doubt,
        dho:DullnessDrowsiness,
        dho:IllWill,
        dho:RestlessnessRemorse,
        dho:SensualDesire .

dho:ReviewedByOwner a dho:ReviewStatus ;
    rdfs:label "reviewed by the project owner"@en .

dho:ReviewedExternally a dho:ReviewStatus ;
    rdfs:label "reviewed by a qualified outside reader"@en .

dho:as a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "as"@en ;
    rdfs:domain dho:Definition ;
    rdfs:range dho:Concept .

dho:attention a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "attention"@en ;
    rdfs:domain dho:Nutriment ;
    rdfs:range dho:AttentionMode .

dho:basis a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "basis"@en ;
    rdfs:domain dho:Division ;
    rdfs:range dho:DivisionBasis .

dho:c-01 a dho:Condition ;
    dho:citedBy dho:p-sn46.1-1.4,
        dho:p-sn46.11-1.3 ;
    dho:condition dho:Ethics ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:BasisOf ;
    dho:wording "depending on and grounded on ethics" .

dho:c-02 a dho:Condition ;
    dho:citedBy dho:p-sn46.12-1.2,
        dho:p-sn46.48-1.2 ;
    dho:condition dho:GoodFriendship ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:ForerunnerOf ;
    dho:wording "good friendship is the forerunner and harbinger of the arising of the seven awakening factors" .

dho:c-03 a dho:Condition ;
    skos:note "SN 46.50:1.2 gives this only in the Pali (untranslated): kalyāṇamittassetaṁ … pāṭikaṅkhaṁ—satta bojjhaṅge bhāvessati."@en ;
    dho:citedBy dho:p-sn46.12-1.3,
        dho:p-sn46.48-1.3,
        dho:p-sn46.50-1.2,
        dho:p-sn46.50-1.6 ;
    dho:condition dho:GoodFriendship ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Supports ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" .

dho:c-04 a dho:Condition ;
    dho:citedBy dho:p-sn46.13-1.2 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:ForerunnerOf ;
    dho:wording "rational application of mind is the forerunner and harbinger of the arising of the seven awakening factors" .

dho:c-05 a dho:Condition ;
    skos:note "SN 46.49:1.2 gives this only in the Pali (untranslated), for one accomplished in rational application of mind (yonisomanasikārasampanna)."@en ;
    dho:citedBy dho:p-sn46.13-1.3,
        dho:p-sn46.32-1.2,
        dho:p-sn46.49-1.2,
        dho:p-sn46.49-1.6 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Supports ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" .

dho:c-06 a dho:Condition ;
    dho:citedBy dho:p-sn46.31-1.1 ;
    dho:condition dho:Diligence ;
    dho:conditioned dho:SkillfulQualities ;
    dho:relation dho:RootOf ;
    dho:wording "rooted in diligence and meet at diligence" .

dho:c-07 a dho:Condition ;
    dho:citedBy dho:p-sn46.31-1.2 ;
    dho:condition dho:Diligence ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Supports ;
    dho:wording "can expect to develop and cultivate the seven awakening factors" .

dho:c-08 a dho:Condition ;
    dho:citedBy dho:p-sn46.32-1.1 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:SkillfulQualities ;
    dho:relation dho:RootOf ;
    dho:wording "rooted in rational application of mind and meet at rational application of mind" .

dho:c-09 a dho:Condition ;
    skos:note "Said of interior factors: nothing interior gives rise to them like rational application of mind."@en ;
    dho:citedBy dho:p-sn46.49-1.1 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:GivesRiseTo ;
    dho:wording "gives rise to the seven awakening factors like rational application of mind" .

dho:c-10 a dho:Condition ;
    skos:note "Said of exterior factors: nothing exterior gives rise to them like good friendship."@en ;
    dho:citedBy dho:p-sn46.50-1.1 ;
    dho:condition dho:GoodFriendship ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:GivesRiseTo ;
    dho:wording "gives rise to the seven awakening factors like good friendship" .

dho:c-11 a dho:Condition ;
    dho:citedBy dho:p-sn46.24-1.1,
        dho:p-sn46.24-1.5,
        dho:p-sn46.35-1.1 ;
    dho:condition dho:IrrationalAttention ;
    dho:conditioned dho:FiveHindrances ;
    dho:relation dho:WhenThen ;
    dho:result dho:ArisesAndGrows ;
    dho:wording "once arisen they increase and grow" .

dho:c-12 a dho:Condition ;
    dho:citedBy dho:p-sn46.24-1.1,
        dho:p-sn46.24-1.6 ;
    dho:condition dho:IrrationalAttention ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:WhenThen ;
    dho:result dho:DoesNotArise ;
    dho:wording "if they’ve already arisen, they cease" .

dho:c-13 a dho:Condition ;
    dho:citedBy dho:p-sn46.24-2.1,
        dho:p-sn46.24-2.5 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:FiveHindrances ;
    dho:relation dho:WhenThen ;
    dho:result dho:DoesNotAriseGivenUp ;
    dho:wording "if they’ve already arisen they’re given up" .

dho:c-14 a dho:Condition ;
    dho:citedBy dho:p-sn46.24-2.1,
        dho:p-sn46.24-3.1,
        dho:p-sn46.35-2.1 ;
    dho:condition dho:RationalAttention ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:WhenThen ;
    dho:result dho:ArisesAndIsFullyDeveloped ;
    dho:wording "once they’ve arisen, they’re fully developed" .

dho:c-15 a dho:Condition ;
    dho:citedBy dho:p-sn46.38-1.1,
        dho:p-sn46.38-3.4 ;
    dho:condition dho:ListeningToTeaching ;
    dho:conditioned dho:FiveHindrances ;
    dho:relation dho:WhenThen ;
    dho:result dho:IsAbsent ;
    dho:wording "pays attention, applies the mind, concentrates wholeheartedly, and actively listens to the teaching" .

dho:c-16 a dho:Condition ;
    dho:citedBy dho:p-sn46.38-1.1,
        dho:p-sn46.38-3.4 ;
    dho:condition dho:ListeningToTeaching ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:WhenThen ;
    dho:result dho:IsFullyDeveloped ;
    dho:wording "pays attention, applies the mind, concentrates wholeheartedly, and actively listens to the teaching" .

dho:c-17 a dho:Condition ;
    dho:citedBy dho:p-sn46.1-1.12,
        dho:p-sn46.1-1.6,
        dho:p-sn46.11-2.3,
        dho:p-sn46.12-2.3,
        dho:p-sn46.13-2.3,
        dho:p-sn46.130-1.8,
        dho:p-sn46.21-2.5,
        dho:p-sn46.26-2.1,
        dho:p-sn46.26-2.5,
        dho:p-sn46.27-2.2,
        dho:p-sn46.28-2.1,
        dho:p-sn46.28-2.5,
        dho:p-sn46.29-2.2,
        dho:p-sn46.31-2.3,
        dho:p-sn46.32-2.3,
        dho:p-sn46.48-1.6,
        dho:p-sn46.49-1.4,
        dho:p-sn46.49-1.5,
        dho:p-sn46.5-1.7,
        dho:p-sn46.50-1.4,
        dho:p-sn46.50-1.5,
        dho:p-sn46.56-5.3,
        dho:p-sn46.56-6.2,
        dho:p-sn46.57-1.5,
        dho:p-sn46.7-2.3,
        dho:p-sn46.76-1.4,
        dho:p-sn46.76-2.6,
        dho:p-sn46.76-3.4 ;
    dho:condition dho:Seclusion ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:BasisOf ;
    dho:wording "on seclusion, fading away, and cessation" .

dho:c-18 a dho:Condition ;
    dho:citedBy dho:p-sn46.1-1.12,
        dho:p-sn46.1-1.6,
        dho:p-sn46.11-2.3,
        dho:p-sn46.12-2.3,
        dho:p-sn46.13-2.3,
        dho:p-sn46.130-1.8,
        dho:p-sn46.21-2.5,
        dho:p-sn46.26-2.1,
        dho:p-sn46.26-2.5,
        dho:p-sn46.27-2.2,
        dho:p-sn46.28-2.1,
        dho:p-sn46.28-2.5,
        dho:p-sn46.29-2.2,
        dho:p-sn46.31-2.3,
        dho:p-sn46.32-2.3,
        dho:p-sn46.48-1.6,
        dho:p-sn46.49-1.4,
        dho:p-sn46.49-1.5,
        dho:p-sn46.5-1.7,
        dho:p-sn46.50-1.4,
        dho:p-sn46.50-1.5,
        dho:p-sn46.56-5.3,
