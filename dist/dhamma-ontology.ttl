dho:t-sn46.51 a dho:Text ;
    dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    dct:source "SuttaCentral bilara-data: English by Bhikkhu Sujato, Pali Mahāsaṅgīti edition" ;
    skos:prefLabel "SN 46.51 Āhārasutta — Nourishing"@en ;
    dho:coverage dho:FullyEncoded ;
    dho:encodes "All 24 statements of what fuels and starves the five hindrances and seven awakening factors, each as a nutriment node (object + kind of attention + effect). The opening statement (1.2) anchors both lists." ;
    dho:layer dho:SuttaLayer ;
    dho:leftOut "Nothing doctrinal. The question (x.1) and conclusion (x.4) of each section restate the claim and are not cited separately." ;
    dho:modelledBy "project owner with Claude (AI assistant), from SuttaCentral's text" ;
    dho:modelledOn "2026-11-13"^^xsd:date ;
    dho:review dho:Unreviewed ;
    dho:url "https://suttacentral.net/sn46.51/en/sujato"^^xsd:anyURI .

dho:Passage a owl:Class ;
    rdfs:label "Passage"@en ;
    rdfs:comment "One segment of a text, identified by its SuttaCentral segment id (e.g. sn46.51:16.2)."@en .

