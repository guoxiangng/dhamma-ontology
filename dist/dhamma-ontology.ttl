dho:c-a1 a dho:Condition ;
    skos:note "When the heart is overcome and mired in each hindrance, without truly knowing and seeing the escape from it. Given in full for sensual desire, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-1.10,
        dho:p-sn46.56-1.11,
        dho:p-sn46.56-2.3,
        dho:p-sn46.56-2.4,
        dho:p-sn46.56-3.4,
        dho:p-sn46.56-3.5 ;
    dho:condition dho:FiveHindrances ;
    dho:conditioned dho:NotKnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for not knowing and not seeing" .

dho:c-a2 a dho:Condition ;
    skos:note "They truly know and see with a mind that has developed each awakening factor. Given in full for mindfulness, abbreviated for the others."@en ;
    dho:citedBy dho:p-sn46.56-1.12,
        dho:p-sn46.56-1.13,
        dho:p-sn46.56-5.4,
        dho:p-sn46.56-5.5,
        dho:p-sn46.56-6.3,
        dho:p-sn46.56-6.4 ;
    dho:condition dho:SevenAwakeningFactors ;
    dho:conditioned dho:KnowingSeeing ;
    dho:relation dho:CauseOf ;
    dho:wording "a cause and reason for knowing and seeing" .

dho:c-f1 a dho:Condition ;
    dho:citedBy dho:p-sn46.6-2.7,
        dho:p-sn46.6-2.8,
        dho:p-sn46.6-3.1,
        dho:p-sn46.6-5.7 ;
    dho:condition dho:SenseRestraint ;
    dho:conditioned dho:ThreeGoodConducts ;
    dho:relation dho:Fulfils ;
    dho:wording "sense restraint is developed and cultivated so as to fulfill the three kinds of good conduct" .

dho:c-f2 a dho:Condition ;
    dho:citedBy dho:p-sn46.6-2.5,
        dho:p-sn46.6-2.6,
        dho:p-sn46.6-6.1,
        dho:p-sn46.6-6.3 ;
    dho:condition dho:ThreeGoodConducts ;
    dho:conditioned dho:FourMindfulnessMeditations ;
    dho:relation dho:Fulfils ;
    dho:wording "the three kinds of good conduct are developed and cultivated so as to fulfill the four kinds of mindfulness meditation" .

dho:c-f3 a dho:Condition ;
    dho:citedBy dho:p-sn46.6-2.3,
        dho:p-sn46.6-2.4,
        dho:p-sn46.6-7.1,
        dho:p-sn46.6-7.6 ;
    dho:condition dho:FourMindfulnessMeditations ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Fulfils ;
    dho:wording "the four kinds of mindfulness meditation are developed and cultivated so as to fulfill the seven awakening factors" .

dho:c-f4 a dho:Condition ;
    dho:citedBy dho:p-sn46.6-2.1,
        dho:p-sn46.6-2.2,
        dho:p-sn46.6-8.1,
        dho:p-sn46.6-8.4 ;
    dho:condition dho:SevenAwakeningFactors ;
    dho:conditioned dho:KnowledgeAndFreedom ;
    dho:relation dho:Fulfils ;
    dho:wording "the seven awakening factors are developed and cultivated so as to fulfill knowledge and freedom" .

dho:c-m1 a dho:Condition ;
    skos:note "How the heart's release by love is developed (12.1-12.3). The Pali: each awakening factor developed accompanied by love. Sujato's English: 'develops the heart's release by love together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.54-12.1,
        dho:p-sn46.54-12.2,
        dho:p-sn46.54-12.3 ;
    dho:condition dho:Love ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "mettāsahagataṁ" .

dho:c-m2 a dho:Condition ;
    skos:note "How the heart's release by compassion is developed (13.1-13.3). The Pali: each awakening factor developed accompanied by compassion."@en ;
    dho:citedBy dho:p-sn46.54-13.1,
        dho:p-sn46.54-13.2,
        dho:p-sn46.54-13.3 ;
    dho:condition dho:Compassion ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "karuṇāsahagataṁ" .

dho:c-m3 a dho:Condition ;
    skos:note "How the heart's release by rejoicing is developed (14.1-14.3). The Pali: each awakening factor developed accompanied by rejoicing."@en ;
    dho:citedBy dho:p-sn46.54-14.1,
        dho:p-sn46.54-14.2,
        dho:p-sn46.54-14.3 ;
    dho:condition dho:Rejoicing ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "muditāsahagataṁ" .

dho:c-m4 a dho:Condition ;
    skos:note "How the heart's release by equanimity is developed (15.1-15.3). The Pali even has 'the awakening factor of equanimity accompanied by equanimity' (upekkhāsahagataṁ upekkhāsambojjhaṅgaṁ, 15.3): the practice and the factor are two things here, which supports keeping them as separate concepts (D15)."@en ;
    dho:citedBy dho:p-sn46.54-15.1,
        dho:p-sn46.54-15.2,
        dho:p-sn46.54-15.3 ;
    dho:condition dho:EquanimityImmeasurable ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "upekkhāsahagataṁ" .

dho:c-p57 a dho:Condition ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of a skeleton. Sujato's English: 'develops the perception of a skeleton together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.57-1.4,
        dho:p-sn46.57-1.5,
        dho:p-sn46.57-2.3,
        dho:p-sn46.57-2.4,
        dho:p-sn46.57-3.3,
        dho:p-sn46.57-3.4,
        dho:p-sn46.57-4.3,
        dho:p-sn46.57-4.4,
        dho:p-sn46.57-5.3,
        dho:p-sn46.57-5.4,
        dho:p-sn46.57-6.3,
        dho:p-sn46.57-6.4 ;
    dho:condition dho:SkeletonPerception ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "aṭṭhikasaññāsahagataṁ" .

dho:c-p76 a dho:Condition ;
    skos:note "The Pali: the mendicant develops each awakening factor accompanied by the perception of cessation. Sujato's English: 'develops the perception of cessation together with the awakening factors'."@en ;
    dho:citedBy dho:p-sn46.76-1.3,
        dho:p-sn46.76-1.4,
        dho:p-sn46.76-2.5,
        dho:p-sn46.76-2.6,
        dho:p-sn46.76-3.3,
        dho:p-sn46.76-3.4 ;
    dho:condition dho:CessationPerception ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:Accompanies ;
    dho:wording "nirodhasaññāsahagataṁ" .

dho:c-s1 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-1.9,
        dho:p-sn46.3-2.1 ;
    dho:condition dho:RecollectingTeaching ;
    dho:conditioned dho:Mindfulness ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "as they recollect and think about that teaching" .

dho:c-s2 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-2.4,
        dho:p-sn46.3-3.1 ;
    dho:condition dho:Mindfulness ;
    dho:conditioned dho:Investigation ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they live mindfully in this way they investigate, explore, and inquire into that teaching with wisdom" .

dho:c-s3 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-3.4,
        dho:p-sn46.3-4.1 ;
    dho:condition dho:Investigation ;
    dho:conditioned dho:Energy ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "As they investigate principles with wisdom in this way their energy is roused up and unflagging" .

dho:c-s4 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-4.2,
        dho:p-sn46.3-5.1 ;
    dho:condition dho:Energy ;
    dho:conditioned dho:Rapture ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "rapture not of the flesh arises" .

dho:c-s5 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-5.2,
        dho:p-sn46.3-6.1 ;
    dho:condition dho:Rapture ;
    dho:conditioned dho:Tranquility ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the mind is full of rapture, the body and mind become tranquil" .

dho:c-s6 a dho:Condition ;
    skos:note "Together with bliss: 'when the body is tranquil and one feels bliss'."@en ;
    dho:citedBy dho:p-sn46.3-6.2,
        dho:p-sn46.3-7.1 ;
    dho:condition dho:Tranquility ;
    dho:conditioned dho:Immersion ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "When the body is tranquil and one feels bliss, the mind becomes immersed in samādhi" .

dho:c-s7 a dho:Condition ;
    dho:citedBy dho:p-sn46.3-7.2,
        dho:p-sn46.3-8.1 ;
    dho:condition dho:Immersion ;
    dho:conditioned dho:Equanimity ;
    dho:relation dho:WhenThen ;
    dho:result dho:Arises ;
    dho:wording "They closely watch over that mind immersed in samādhi" .

dho:c-u1 a dho:Condition ;
    skos:note "Pali: 'these seven awakening factors, developed and cultivated, arise unarisen, not apart from (nāññatra) the appearance of a Realized One'. 'To be developed and cultivated' is Sujato's reading of bhāvitā bahulīkatā. A necessary condition, not a sufficient one (D23)."@en ;
    dho:citedBy dho:p-sn46.9-1.1,
        dho:p-sn46.9-1.4 ;
    dho:condition dho:AppearanceOfRealizedOne ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:RequiredFor ;
    dho:result dho:Arises ;
    dho:wording "don’t arise to be developed and cultivated except when a Realized One, a perfected one, a fully awakened Buddha has appeared" .

dho:c-u2 a dho:Condition ;
    skos:note "Same form as SN 46.9 (c-u1), with the Holy One's training (sugatavinaya) in place of the appearance of a Realized One."@en ;
    dho:citedBy dho:p-sn46.10-1.1,
        dho:p-sn46.10-1.4 ;
    dho:condition dho:SugataVinaya ;
    dho:conditioned dho:SevenAwakeningFactors ;
    dho:relation dho:RequiredFor ;
    dho:result dho:Arises ;
    dho:wording "don’t arise to be developed and cultivated apart from the Holy One’s training" .

dho:citationNote a owl:DatatypeProperty ;
    rdfs:label "citation note"@en ;
    rdfs:comment "Free-text reference for sources we do not hold verbatim (e.g. Visuddhimagga). Claims that only have this are flagged as unverified."@en .

dho:citedBy a owl:ObjectProperty ;
    rdfs:label "cited by"@en ;
    rdfs:comment "The passage(s) that state this claim."@en ;
    rdfs:range dho:Passage .

dho:condition a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:label "condition"@en ;
