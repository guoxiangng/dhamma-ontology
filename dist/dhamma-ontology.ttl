    dho:layer dho:CommentaryLayer ;
    dho:leftOut "Everything else. The text is not held; the pairings need checking against an edition before they can be marked verified." ;
    dho:modelledBy "project owner with Claude (AI assistant), from memory of the text, not checked against it" ;
    dho:modelledOn "2026-11-13"^^xsd:date ;
    dho:review dho:Unreviewed .

